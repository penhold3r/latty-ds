// This file is not used by "docusaurus start/build" commands.
// It is here to improve your IDE experience (type-checking, autocompletion...),
// and can also run the package.json "typecheck" script manually.
{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // baseUrl has to be repeated here: the copy inherited from
    // @docusaurus/tsconfig resolves relative to that package, not this site.
    // TypeScript 6 reports it as deprecated (TS5101), so silence that with
    // "6.0" (TS 5.x would reject the value — the workspace is on TS 6+).
    // Don't "unset" it with null instead: Playwright's own tsconfig loader
    // (used by the a11y suite) can't handle a null baseUrl.
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "strict": true
  },
  "exclude": [".docusaurus", "build"]
}
