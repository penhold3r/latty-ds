---
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const nav = [
  {
    label: 'Introduction',
    items: [
      { label: 'What is Latty?', href: '/getting-started/introduction' },
      { label: 'Installation', href: '/getting-started/installation' },
      { label: 'Usage', href: '/getting-started/usage' },
      { label: 'Theming', href: '/getting-started/theming' }
    ]
  },
  {
    label: 'Components',
    items: [
      { label: 'Accordion', href: '/components/accordion' },
      { label: 'Alert', href: '/components/alert' },
      { label: 'Avatar', href: '/components/avatar' },
      { label: 'Badge', href: '/components/badge' },
      { label: 'Breadcrumb', href: '/components/breadcrumb' },
      { label: 'Button', href: '/components/button' },
      { label: 'Checkbox', href: '/components/checkbox' },
      { label: 'Chip', href: '/components/chip' },
      { label: 'Dialog', href: '/components/dialog' },
      { label: 'Divider', href: '/components/divider' },
      { label: 'Dropdown', href: '/components/dropdown' },
      { label: 'Header', href: '/components/header' },
      { label: 'Link', href: '/components/link' },
      { label: 'List', href: '/components/list' },
      { label: 'Navigation', href: '/components/navigation' },
      { label: 'Progress', href: '/components/progress' },
      { label: 'Radio', href: '/components/radio' },
      { label: 'Select', href: '/components/select' },
      { label: 'Skeleton', href: '/components/skeleton' },
      { label: 'Slider', href: '/components/slider' },
      { label: 'Snackbar', href: '/components/snackbar' },
      { label: 'Spinner', href: '/components/spinner' },
      { label: 'Surface', href: '/components/surface' },
      { label: 'Switch', href: '/components/switch' },
      { label: 'Tab', href: '/components/tab' },
      { label: 'Tooltip', href: '/components/tooltip' },
      { label: 'Table', href: '/components/table' },
      { label: 'Text', href: '/components/text' },
      { label: 'Textfield', href: '/components/textfield' }
    ]
  },
  {
    label: 'Icons',
    items: [{ label: 'Overview', href: '/icons' }]
  },
  {
    label: 'Tokens',
    items: [
      { label: 'Overview', href: '/tokens/overview' },
      { label: 'Colors', href: '/tokens/colors' },
      { label: 'Spacing', href: '/tokens/spacing' },
      { label: 'Semantic Tokens', href: '/tokens/semantic' }
    ]
  }
];

function isActive(href: string) {
  const full = base + href;
  return currentPath === full || currentPath === full + '/';
}

function isSectionActive(items: { href: string }[]) {
  return items.some((item) => isActive(item.href));
}
---

<nav class="sidebar" id="sidebar" aria-label="Documentation navigation">
  <div class="sidebar-inner">
    {
      nav.map((section) => (
        <lt-accordion variant="clean" label={section.label} open={isSectionActive(section.items) || undefined}>
          <lt-nav>
            {section.items.map((item) => (
              <lt-nav-item href={base + item.href} label={item.label} active={isActive(item.href) || undefined} />
            ))}
          </lt-nav>
        </lt-accordion>
      ))
    }
  </div>
</nav>

<style>
  .sidebar {
    width: var(--sidebar-width, 240px);
    flex-shrink: 0;
    position: sticky;
    top: var(--topbar-height, 56px);
    height: calc(100vh - var(--topbar-height, 56px));
    overflow-y: auto;
    border-right: 1px solid var(--lt-color-neutral-200);
    background: var(--lt-color-neutral-50);
    padding: var(--lt-spacing-4) 0;

    /* Accordion header: bold section title */
    --lt-accordion-summary-padding: var(--lt-spacing-2) var(--lt-spacing-4);
    --lt-accordion-content-padding: 0;
    --lt-accordion-header-color: var(--lt-color-neutral-800);
    --lt-accordion-header-font-size: 0.875rem;
    --lt-accordion-header-font-weight: 700;

    /* Nav item sizing and active state */
    --lt-nav-item-font-size: 0.875rem;
    --lt-nav-item-padding: var(--lt-spacing-1) var(--lt-spacing-3);
    --lt-nav-item-active-bg: var(--lt-color-primary-50);
    --lt-nav-item-active-color: var(--lt-color-primary-600);
  }

  .sidebar-inner {
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 768px) {
    .sidebar {
      position: fixed;
      top: var(--topbar-height, 56px);
      left: 0;
      z-index: 100;
      height: calc(100vh - var(--topbar-height, 56px));
      transform: translateX(-100%);
      transition: transform 250ms ease;
      box-shadow: 4px 0 16px rgba(0, 0, 0, 0.1);
    }

    .sidebar.is-open {
      transform: translateX(0);
    }
  }
</style>
