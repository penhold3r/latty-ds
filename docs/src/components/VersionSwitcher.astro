---
const currentVersion = 'v1.0';
const versions = [
  { label: 'v1.0 (latest)', value: 'v1.0', path: '/' }
  // { label: 'v0.9', value: 'v0.9', path: '/v0.9/' },
  // Add more versions as needed
];
---

<lt-select id="version-select" value={currentVersion} data-versions={JSON.stringify(versions)}></lt-select>

<script>
  import '@latty/web';

  const el = document.getElementById('version-select') as any;
  if (el) {
    const versions: { label: string; value: string; path: string }[] = JSON.parse(el.dataset.versions);
    el.options = versions.map((v) => ({ label: v.label, value: v.value }));

    el.addEventListener('change', (e: CustomEvent<{ value: string }>) => {
      const match = versions.find((v) => v.value === e.detail.value);
      if (match && match.path !== window.location.pathname) {
        window.location.href = match.path;
      }
    });
  }
</script>
