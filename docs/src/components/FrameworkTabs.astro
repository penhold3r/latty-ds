---
import CodeSnippet from './CodeSnippet.astro';

interface Props {
  html: string;
  react: string;
  vue?: string;
}

const { html, react, vue } = Astro.props;
---

<div class="framework-tabs">
  <lt-tab-group value="html">
    <lt-tab value="html" label="Web Component"></lt-tab>
    <lt-tab value="react" label="React"></lt-tab>
    {vue && <lt-tab value="vue" label="Vue" />}

    <div slot="panel" data-value="html"><CodeSnippet code={html} lang="html" /></div>
    <div slot="panel" data-value="react"><CodeSnippet code={react} lang="tsx" /></div>
    {
      vue && (
        <div slot="panel" data-value="vue">
          <CodeSnippet code={vue} lang="vue" />
        </div>
      )
    }
  </lt-tab-group>
</div>

<style>
  .framework-tabs {
    margin: var(--lt-spacing-4) 0;
  }

  .framework-tabs :global([slot='panel'] .snippet) {
    margin: 0;
  }
</style>

<script>
  import '@latty/web';
</script>
