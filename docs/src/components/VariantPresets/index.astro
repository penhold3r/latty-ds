---
import manifest from '@latty/web/manifest.json';

interface Props {
  tag: string;
  slotContent?: string;
  prop?: string;
}

const { tag, slotContent = '', prop } = Astro.props;

const allManifest = manifest as any;
const component = allManifest[tag];
const members = (component?.members ?? []) as any[];

const variantMember =
  members.find((m: any) => m.name === (prop ?? 'variant')) ??
  members.find((m: any) => m.name === 'appearance') ??
  members.find((m: any) => m.type === 'select' && (m.options?.length ?? 0) > 1);

const options: string[] = (variantMember?.options ?? []).filter((o: string) => o !== '');
---

{
  options.length > 0 && (
    <div class="variant-presets">
      <div class="variant-presets-row">
        {options.map((option: string) => (
          <div class="variant-preset-item">
            <div
              class="variant-preset-preview"
              set:html={`<${tag} ${variantMember.name}="${option}">${slotContent}</${tag}>`}
            />
            <span class="variant-preset-label">{option}</span>
          </div>
        ))}
      </div>
    </div>
  )
}

<style>
  @import './VariantPresets.styles.css';
</style>
