---
interface Props {
  name: string;
  baseColor: string;
}

const { name, baseColor } = Astro.props;
const shades = [50, 100, 200, 300, 400, 500, 600, 700, 800, 900, 950];
---

<div class="palette">
  <h2 class="palette__name">{name}</h2>
  <div class="palette__grid">
    {
      shades.map((shade) => (
        <div
          class:list={['swatch', { 'swatch--dark': shade >= 600 }]}
          style={`--swatch-bg: var(--lt-color-${baseColor}-${shade})`}
        >
          {shade}
        </div>
      ))
    }
  </div>
</div>

<script>
  import './ColorPalette.script.ts';
</script>

<style>
  .palette {
    margin-bottom: var(--lt-spacing-6);
  }

  .palette__name {
    text-transform: capitalize;
    margin-bottom: var(--lt-spacing-3);
  }

  .palette__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
    gap: var(--lt-spacing-2);
  }

  .swatch {
    background: var(--swatch-bg);
    padding: var(--lt-spacing-4);
    border-radius: var(--lt-border-radius);
    text-align: center;
    color: var(--lt-color-neutral-900);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .swatch--dark {
    color: white;
  }
</style>
