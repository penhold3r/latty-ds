---
import { Code } from 'astro:components';

interface Props {
  code: string;
  lang?: string;
  title?: string;
}

const { code, lang = 'html', title } = Astro.props;
const snippetId = `snippet-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="snippet">
  <div class="snippet-header">
    <span class="snippet-lang">{title ?? lang}</span>
    <lt-icon class="copy-icon" name="copy" data-snippet-id={snippetId} role="button" aria-label="Copy code" tabindex="0"
    ></lt-icon>
  </div>
  <div id={snippetId} class="snippet-body">
    <Code code={code.trim()} lang={lang} theme="github-dark" />
  </div>
</div>

<style>
  .snippet {
    border-radius: 8px;
    overflow: hidden;
    margin: var(--lt-spacing-4) 0;
    border: 1px solid var(--lt-color-secondary-700);
  }

  .snippet-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--lt-spacing-2) var(--lt-spacing-4);
    background: var(--lt-color-secondary-900);
    border-bottom: 1px solid var(--lt-color-secondary-700);
  }

  .snippet-lang {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lt-color-secondary-300);
  }

  .copy-icon {
    color: var(--lt-color-secondary-300);
    cursor: pointer;
    transition: color 150ms ease;
  }

  .copy-icon:hover {
    color: var(--lt-color-neutral-100);
  }

  .snippet-body :global(pre) {
    margin: 0;
    padding: var(--lt-spacing-4) !important;
    border-radius: 0;
    background: var(--lt-color-secondary-800) !important;
  }

  .snippet-body :global(code) {
    background: none;
    padding: 0;
    font-size: 0.8125rem;
    line-height: 1.6;
  }
</style>

<script>
  import '@latty/web';
  import '@latty/icons';

  document.querySelectorAll('[data-snippet-id]').forEach((icon) => {
    icon.addEventListener('click', async () => {
      const el = icon as HTMLElement;
      const id = el.dataset.snippetId!;
      const code = document.getElementById(id)?.textContent ?? '';
      await navigator.clipboard.writeText(code.trim());
      el.setAttribute('name', 'check');
      setTimeout(() => {
        el.setAttribute('name', 'copy');
      }, 1500);
    });
  });
</script>
