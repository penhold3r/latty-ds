---
import { createStyleSheet } from '@latty/tokens/configure';
const tokenCss = createStyleSheet({
  colors: { primary: '#4f46e5', secondary: '#7c3aed' },
  font: { family: "'Inter', system-ui, sans-serif" },
  border: { radius: '0.5rem' }
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Meridian — Analytics Dashboard</title>
    <style id="lt-tokens" set:html={tokenCss}></style>
    <script is:inline>
      const urlTheme = new URLSearchParams(location.search).get('theme');
      const saved = urlTheme || localStorage.getItem('lt-theme');
      if (saved) document.documentElement.setAttribute('data-theme', saved);
    </script>
  </head>
  <body>
    <lt-header background="primary">
      <a slot="logo" href="#" class="brand">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="3" y="12" width="4" height="9" rx="1" fill="currentColor"></rect>
          <rect x="10" y="7" width="4" height="14" rx="1" fill="currentColor"></rect>
          <rect x="17" y="3" width="4" height="18" rx="1" fill="currentColor"></rect>
        </svg>
        <span>Meridian</span>
      </a>
      <div slot="after" class="header-user">
        <lt-avatar name="Sara Chen" size="sm" color="secondary"></lt-avatar>
        <lt-text variant="label" tag="span" style="color:white;opacity:0.9;">Sara Chen</lt-text>
      </div>
    </lt-header>

    <div class="shell-body">
      <aside class="sidebar" aria-label="Application navigation">
        <lt-nav orientation="vertical">
          <lt-nav-item label="Dashboard" icon-start="grid" active></lt-nav-item>
          <lt-nav-item label="Analytics" icon-start="chart"></lt-nav-item>
          <lt-nav-item label="Reports" icon-start="folder"></lt-nav-item>
          <lt-nav-item label="Settings" icon-start="settings"></lt-nav-item>
        </lt-nav>
      </aside>

      <main class="main-content" id="main-content">
        <div class="page-header">
          <div>
            <lt-text variant="h1" tag="h1" style="display:block;">Dashboard</lt-text>
            <lt-text
              variant="body"
              tag="p"
              style="display:block;color:var(--lt-text-subtle);margin-top:var(--lt-spacing-1);"
            >
              Welcome back, Sara. Here's what's happening this month.
            </lt-text>
          </div>
        </div>

        <div class="kpi-grid" aria-label="Key performance metrics">
          <lt-surface elevation="1" class="kpi-card">
            <lt-text
              variant="overline"
              tag="p"
              style="display:block;color:var(--lt-text-subtle);margin-bottom:var(--lt-spacing-2);"
              >Total Revenue</lt-text
            >
            <lt-text variant="display-lg" tag="p" style="display:block;line-height:1;margin-bottom:var(--lt-spacing-3);"
              >$124,800</lt-text
            >
            <lt-badge variant="success" content="↑ 12.4%" size="sm"></lt-badge>
          </lt-surface>

          <lt-surface elevation="1" class="kpi-card">
            <lt-text
              variant="overline"
              tag="p"
              style="display:block;color:var(--lt-text-subtle);margin-bottom:var(--lt-spacing-2);">Active Users</lt-text
            >
            <lt-text variant="display-lg" tag="p" style="display:block;line-height:1;margin-bottom:var(--lt-spacing-3);"
              >8,420</lt-text
            >
            <lt-badge variant="success" content="↑ 6.1%" size="sm"></lt-badge>
          </lt-surface>

          <lt-surface elevation="1" class="kpi-card">
            <lt-text
              variant="overline"
              tag="p"
              style="display:block;color:var(--lt-text-subtle);margin-bottom:var(--lt-spacing-2);"
              >Conversion Rate</lt-text
            >
            <lt-text variant="display-lg" tag="p" style="display:block;line-height:1;margin-bottom:var(--lt-spacing-3);"
              >3.6%</lt-text
            >
            <lt-badge variant="error" content="↓ 0.3%" size="sm"></lt-badge>
          </lt-surface>

          <lt-surface elevation="1" class="kpi-card">
            <lt-text
              variant="overline"
              tag="p"
              style="display:block;color:var(--lt-text-subtle);margin-bottom:var(--lt-spacing-2);">Avg. Session</lt-text
            >
            <lt-text variant="display-lg" tag="p" style="display:block;line-height:1;margin-bottom:var(--lt-spacing-3);"
              >4m 12s</lt-text
            >
            <lt-badge variant="success" content="↑ 0.8%" size="sm"></lt-badge>
          </lt-surface>
        </div>

        <lt-surface elevation="1" class="table-card">
          <div class="table-header">
            <div>
              <lt-text variant="h2" tag="h2" style="display:block;">Customer Activity</lt-text>
              <lt-text
                variant="body-sm"
                tag="p"
                style="display:block;color:var(--lt-text-subtle);margin-top:var(--lt-spacing-1);"
              >
                Showing data for <span id="range-label">Last 30 days</span>
              </lt-text>
            </div>
            <lt-button variant="secondary" appearance="outlined" size="sm" icon-start="download">Export CSV</lt-button>
          </div>
          <div class="filters-row">
            <lt-select id="time-range" size="sm"></lt-select>
            <lt-chip deletable size="sm" variant="secondary" appearance="outlined">All regions</lt-chip>
            <lt-chip deletable size="sm" variant="secondary" appearance="outlined">Web traffic</lt-chip>
          </div>
          <lt-table id="activity-table" striped hoverable density="compact"></lt-table>
        </lt-surface>

        <lt-alert variant="info" title="Scheduled maintenance" closable>
          Analytics data may be delayed on Sunday 18 May between 02:00–04:00 UTC.
        </lt-alert>
      </main>
    </div>
  </body>
</html>

<script>
  import './_pulse-analytics.script.ts';
</script>

<style>
  @import './pulse-analytics.styles.css';
</style>
