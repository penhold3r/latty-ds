---
import BaseLayout from '../layouts/BaseLayout.astro';
import CodeSnippet from '../components/CodeSnippet.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Latty Design System"
  description="A framework-agnostic design system built on design tokens and Web Components"
>
  <div class="hero">
    <lt-badge content="Design System"></lt-badge>
    <lt-text variant="display-xl" as="h1" class="hero-title">Structure beneath every interface</lt-text>
    <lt-text variant="lead" class="hero-subtitle">
      A lattice is an invisible grid that gives things their shape — every crystal, every fabric, every well-built UI.
      Latty is that grid for your product: design tokens as the structure, Web Components as the surface. Change the
      lattice, everything moves with it.
    </lt-text>
    <div class="hero-actions">
      <lt-button href={`${base}/getting-started/introduction`} variant="primary" size="lg">Get started</lt-button>
      <lt-button href={`${base}/components/button`} variant="primary" appearance="outlined" size="lg"
        >Browse components</lt-button
      >
    </div>
  </div>

  <div class="features">
    <lt-surface appearance="outlined" elevation="0" background-color="--lt-bg-subtle" class="feature">
      <div class="feature-icon"><lt-icon name="diamond" size="lg"></lt-icon></div>
      <lt-text variant="h6">Tokens first</lt-text>
      <lt-text variant="body-sm">
        Design tokens are the single source of truth. They generate CSS custom properties, JSON exports, and TypeScript
        types — change once, update everywhere.
      </lt-text>
    </lt-surface>
    <lt-surface appearance="outlined" elevation="0" background-color="--lt-bg-subtle" class="feature">
      <div class="feature-icon"><lt-icon name="hexagon" size="lg"></lt-icon></div>
      <lt-text variant="h6">Framework agnostic</lt-text>
      <lt-text variant="body-sm">
        Built on Web Components, Latty works natively in vanilla HTML, React, Angular, Vue, Svelte, or any other
        framework without wrappers.
      </lt-text>
    </lt-surface>
    <lt-surface appearance="outlined" elevation="0" background-color="--lt-bg-subtle" class="feature">
      <div class="feature-icon"><lt-icon name="double-circle" size="lg"></lt-icon></div>
      <lt-text variant="h6">Fully themeable</lt-text>
      <lt-text variant="body-sm">
        Every visual decision is a CSS custom property. Override tokens globally or per-component to create a completely
        custom brand.
      </lt-text>
    </lt-surface>
  </div>

  <div class="quick-start">
    <lt-text variant="h2" as="h2" class="quick-start-heading">Quick start</lt-text>
    <CodeSnippet lang="bash" code="pnpm add @latty/tokens @latty/web" />
    <CodeSnippet lang="js" code={`import '@latty/tokens/dist/tokens.css';\nimport '@latty/web';`} />
    <CodeSnippet
      lang="html"
      code={`<lt-button variant="primary" icon-start="save">Save changes</lt-button>\n\n<lt-textfield label="Email" type="email" required></lt-textfield>`}
    />
    <lt-link href={`${base}/getting-started/installation`}>Full installation guide →</lt-link>
  </div>
</BaseLayout>

<script>
  import '@latty/web';
  import '@latty/icons';
</script>

<style>
  .hero {
    padding: var(--lt-spacing-10) 0 var(--lt-spacing-12);
    border-bottom: 1px solid var(--lt-color-neutral-200);
    margin-bottom: var(--lt-spacing-10);
  }

  .hero-title {
    color: var(--lt-color-secondary-500);
    margin: var(--lt-spacing-4) 0;
  }

  .hero-subtitle {
    color: var(--lt-color-neutral-600);
    margin-bottom: var(--lt-spacing-6);
  }

  .hero-actions {
    display: flex;
    gap: var(--lt-spacing-3);
    flex-wrap: wrap;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--lt-spacing-6);
    margin-bottom: var(--lt-spacing-12);
    align-items: stretch;
  }

  .feature::part(surface) {
    padding: var(--lt-spacing-5);
    height: 100%;
  }

  .feature-icon {
    color: var(--lt-color-primary-500);
    margin-bottom: var(--lt-spacing-3);
    display: flex;
  }

  .feature lt-text[variant='h6'] {
    margin-bottom: var(--lt-spacing-2);
  }

  .feature lt-text[variant='body-sm'] {
    color: var(--lt-color-neutral-600);
  }

  .quick-start {
    margin-bottom: var(--lt-spacing-12);
  }

  .quick-start-heading {
    margin-bottom: var(--lt-spacing-4);
  }

  .quick-start pre {
    margin-bottom: var(--lt-spacing-3);
  }

  lt-link {
    display: inline-block;
    margin-top: var(--lt-spacing-4);
  }
</style>
