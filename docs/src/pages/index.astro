---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="Latty Design System"
  description="A framework-agnostic design system built on design tokens and Web Components"
>
  <div class="hero">
    <lt-badge content="Design System"></lt-badge>
    <lt-text variant="display-lg" as="h1" class="hero-title">Structure beneath<br />every interface</lt-text>
    <p class="hero-subtitle">
      A lattice is an invisible grid that gives things their shape — every crystal, every fabric, every well-built UI.
      Latty is that grid for your product: design tokens as the structure, Web Components as the surface. Change the
      lattice, everything moves with it.
    </p>
    <div class="hero-actions">
      <a href={`${base}/getting-started/introduction`} class="btn-primary">Get started</a>
      <a href={`${base}/components/button`} class="btn-secondary">Browse components</a>
    </div>
  </div>

  <div class="features">
    <lt-surface variant="outlined" elevation="0" background-color="--lt-bg-subtle" class="feature">
      <div class="feature-icon"><lt-icon name="diamond" size="lg"></lt-icon></div>
      <lt-text variant="h6">Tokens first</lt-text>
      <lt-text variant="body-sm">
        Design tokens are the single source of truth. They generate CSS custom properties, JSON exports, and TypeScript
        types — change once, update everywhere.
      </lt-text>
    </lt-surface>
    <lt-surface variant="outlined" elevation="0" background-color="--lt-bg-subtle" class="feature">
      <div class="feature-icon"><lt-icon name="hexagon" size="lg"></lt-icon></div>
      <lt-text variant="h6">Framework agnostic</lt-text>
      <lt-text variant="body-sm">
        Built on Web Components, Latty works natively in vanilla HTML, React, Angular, Vue, Svelte, or any other
        framework without wrappers.
      </lt-text>
    </lt-surface>
    <lt-surface variant="outlined" elevation="0" background-color="--lt-bg-subtle" class="feature">
      <div class="feature-icon"><lt-icon name="double-circle" size="lg"></lt-icon></div>
      <lt-text variant="h6">Fully themeable</lt-text>
      <lt-text variant="body-sm">
        Every visual decision is a CSS custom property. Override tokens globally or per-component to create a completely
        custom brand.
      </lt-text>
    </lt-surface>
  </div>

  <div class="quick-start">
    <h2>Quick start</h2>
    <pre><code>pnpm add @latty/tokens @latty/web</code></pre>
    <pre><code class="language-js">import '@latty/tokens/dist/tokens.css';
import '@latty/web';</code></pre>
    <pre><code class="language-html">&lt;lt-button variant="primary" icon="save"&gt;Save changes&lt;/lt-button&gt;

&lt;lt-textfield label="Email" type="email" required&gt;&lt;/lt-textfield&gt;</code></pre>
    <lt-link href={`${base}/getting-started/installation`}>Full installation guide →</lt-link>
  </div>
</BaseLayout>

<script>
  import '@latty/web';
  import '@latty/icons';
</script>

<style>
  .hero {
    padding: var(--lt-spacing-10) 0 var(--lt-spacing-12);
    border-bottom: 1px solid var(--lt-color-neutral-200);
    margin-bottom: var(--lt-spacing-10);
  }

  .hero-title {
    --lt-text-weight: 700;
    color: var(--lt-color-neutral-900);
    margin-bottom: var(--lt-spacing-4);
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--lt-color-neutral-600);
    line-height: 1.7;
    margin-bottom: var(--lt-spacing-6);
  }

  .hero-actions {
    display: flex;
    gap: var(--lt-spacing-3);
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: var(--lt-spacing-3) var(--lt-spacing-5);
    background: var(--lt-color-primary-500);
    color: #fff;
    font-weight: 600;
    font-size: 0.9375rem;
    border-radius: 8px;
    text-decoration: none;
    transition: background 150ms;
  }

  .btn-primary:hover {
    background: var(--lt-color-primary-600);
    text-decoration: none;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: var(--lt-spacing-3) var(--lt-spacing-5);
    background: var(--lt-color-neutral-100);
    color: var(--lt-color-neutral-800);
    font-weight: 600;
    font-size: 0.9375rem;
    border-radius: 8px;
    text-decoration: none;
    border: 1px solid var(--lt-color-neutral-200);
    transition: background 150ms;
  }

  .btn-secondary:hover {
    background: var(--lt-color-neutral-200);
    text-decoration: none;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--lt-spacing-6);
    margin-bottom: var(--lt-spacing-12);
  }

  .feature::part(surface) {
    padding: var(--lt-spacing-5);
  }

  .feature-icon {
    color: var(--lt-color-primary-500);
    margin-bottom: var(--lt-spacing-3);
    display: flex;
  }

  .feature lt-text[variant='h6'] {
    color: var(--lt-color-neutral-900);
    margin-bottom: var(--lt-spacing-2);
  }

  .feature lt-text[variant='body-sm'] {
    color: var(--lt-color-neutral-600);
  }

  .quick-start {
    margin-bottom: var(--lt-spacing-12);
  }

  .quick-start h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--lt-color-neutral-900);
    margin-bottom: var(--lt-spacing-4);
  }

  .quick-start pre {
    margin-bottom: var(--lt-spacing-3);
  }

  lt-link {
    display: inline-block;
    margin-top: var(--lt-spacing-4);
  }
</style>
