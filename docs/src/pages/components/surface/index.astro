---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ComponentPlayground from '../../../components/ComponentPlayground.astro';
import FrameworkTabs from '../../../components/FrameworkTabs.astro';
import ApiTable from '../../../components/ApiTable.astro';
---

<BaseLayout title="Surface" description="Container with elevation and surface styling">
  <lt-text variant="h1">Surface</lt-text>
  <lt-text variant="body">
    A container that applies elevation shadows and surface background variants. Use it to build cards, panels, and
    layered layouts.
  </lt-text>

  <lt-text variant="h2">Playground</lt-text>
  <ComponentPlayground
    tag="lt-surface"
    content={`<lt-text variant="body">Surface content goes here</lt-text>`}
    previewHeight="120px"
  />

  <lt-text variant="h2">Usage</lt-text>
  <FrameworkTabs
    html={`
<lt-surface elevation="2">
  <p>Card content</p>
</lt-surface>

<lt-surface elevation="3" appearance="outlined">
  <p>Outlined panel</p>
</lt-surface>
    `}
    react={`
import { Surface } from '@latty/react';

<Surface elevation="2">
  <p>Card content</p>
</Surface>

<Surface elevation="3" appearance="outlined">
  <p>Outlined panel</p>
</Surface>
    `}
    vue={`
<template>
  <lt-surface elevation="2">
    <p>Card content</p>
  </lt-surface>

  <lt-surface elevation="3" appearance="outlined">
    <p>Outlined panel</p>
  </lt-surface>
</template>
    `}
  />

  <lt-text variant="h2">API</lt-text>
  <ApiTable tag="lt-surface" />
</BaseLayout>

<script>
  import '@latty/web';
</script>
