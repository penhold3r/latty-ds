---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PlaygroundShell from '../../../components/PlaygroundShell.astro';
import FrameworkTabs from '../../../components/FrameworkTabs.astro';
import ApiTable from '../../../components/ApiTable.astro';
---

<BaseLayout title="Select" description="Dropdown select component">
  <lt-text variant="h1">Select</lt-text>
  <lt-text variant="body">
    A custom dropdown with labels, placeholder, helper text, and validation states. The <code>options</code> property is set
    via JavaScript as an array of <code>&#123; value, label &#125;</code> objects.
  </lt-text>

  <lt-text variant="h2">Playground</lt-text>
  <PlaygroundShell id="select-playground">
    <div slot="preview">
      <lt-select id="playground-select" label="Country" placeholder="Select a country" style="width:260px;"></lt-select>
    </div>
    <div slot="controls">
      <div class="control-row">
        <label class="control-label" for="ctrl-size">size</label>
        <select class="control-select" id="ctrl-size">
          <option value="sm">sm</option>
          <option value="md" selected>md</option>
          <option value="lg">lg</option>
        </select>
      </div>
      <div class="control-row">
        <label class="control-label" for="ctrl-variant">variant</label>
        <select class="control-select" id="ctrl-variant">
          <option value="default" selected>default</option>
          <option value="success">success</option>
          <option value="warning">warning</option>
          <option value="error">error</option>
        </select>
      </div>
      <div class="control-row">
        <label class="control-label" for="ctrl-disabled">disabled</label>
        <input class="control-toggle" type="checkbox" id="ctrl-disabled" />
      </div>
      <div class="control-row">
        <label class="control-label" for="ctrl-required">required</label>
        <input class="control-toggle" type="checkbox" id="ctrl-required" />
      </div>
      <div class="control-row">
        <label class="control-label" for="ctrl-label">label</label>
        <input class="control-text" type="text" id="ctrl-label" value="Country" />
      </div>
      <div class="control-row">
        <label class="control-label" for="ctrl-placeholder">placeholder</label>
        <input class="control-text" type="text" id="ctrl-placeholder" value="Select a country" />
      </div>
      <div class="control-row">
        <label class="control-label" for="ctrl-helper">helper-text</label>
        <input class="control-text" type="text" id="ctrl-helper" value="" />
      </div>
      <div class="control-row">
        <label class="control-label" for="ctrl-theme">theme</label>
        <select class="control-select" id="ctrl-theme">
          <option value="" selected>default</option>
          <option value="light">light</option>
          <option value="dark">dark</option>
        </select>
      </div>
    </div>
  </PlaygroundShell>

  <lt-text variant="h2">Usage</lt-text>
  <FrameworkTabs
    html={`
<lt-select id="my-select" label="Country" placeholder="Select a country"></lt-select>

<script type="module">
  const select = document.getElementById('my-select');
  select.options = [
    { value: 'us', label: 'United States' },
    { value: 'gb', label: 'United Kingdom' },
    { value: 'ca', label: 'Canada' },
  ];
  select.addEventListener('change', (e) => console.log(e.detail.value));
<\/script>
    `}
    react={`
import { Select } from '@latty/react';

const options = [
  { value: 'us', label: 'United States' },
  { value: 'gb', label: 'United Kingdom' },
  { value: 'ca', label: 'Canada' },
];

<Select
  label="Country"
  placeholder="Select a country"
  options={options}
  onChange={(e) => console.log(e.detail.value)}
/>
    `}
    vue={`
<script setup lang="ts">
const options = [
  { value: 'us', label: 'United States' },
  { value: 'gb', label: 'United Kingdom' },
  { value: 'ca', label: 'Canada' },
]
</script>

<template>
  <lt-select
    label="Country"
    placeholder="Select a country"
    :options="options"
    @change="(e) => console.log(e.detail.value)"
  ></lt-select>
</template>
    `}
  />

  <lt-text variant="h2">Select vs. Dropdown</lt-text>
  <lt-text variant="body"
    >Both let the user choose from a list of options, but they are built for different purposes:</lt-text
  >
  <table class="compare-table" aria-label="Select vs. Dropdown comparison">
    <thead><tr><th scope="col" aria-label="Property"></th><th>Select</th><th>Dropdown</th></tr></thead>
    <tbody>
      <tr
        ><td><strong>Trigger</strong></td><td>A styled form field with a label and helper text</td><td
          >Any slotted element — button, icon, avatar</td
        ></tr
      >
      <tr
        ><td><strong>Options</strong></td><td
          ><code>options</code> prop — array of <code>&#123; value, label &#125;</code></td
        ><td>Fully custom slot content (<code>lt-dropdown-item</code>)</td></tr
      >
      <tr
        ><td><strong>Use when</strong></td><td
          >Form fields — the user is selecting a value that will be submitted or stored</td
        ><td>Action menus, context menus, overflow menus — the user is choosing an action, not setting a value</td></tr
      >
      <tr
        ><td><strong>Avoid when</strong></td><td
          >You need custom item layouts, icons per item, or the trigger isn't a form field</td
        ><td>You need the selected value to persist or participate in form submission — use Select instead</td></tr
      >
    </tbody>
  </table>

  <lt-text variant="h2">API</lt-text>
  <ApiTable tag="lt-select" />
</BaseLayout>

<script>
  import '@latty/web';

  const select = document.getElementById('playground-select') as any;
  const playground = document.getElementById('select-playground')!;
  const preview = playground.querySelector('.preview')!;
  const codeEl = document.getElementById('select-playground-code')!;

  select.options = [
    { value: 'us', label: 'United States' },
    { value: 'gb', label: 'United Kingdom' },
    { value: 'ca', label: 'Canada' },
    { value: 'de', label: 'Germany' },
    { value: 'fr', label: 'France' }
  ];

  const state: Record<string, any> = {
    size: 'md',
    variant: 'default',
    disabled: false,
    required: false,
    label: 'Country',
    placeholder: 'Select a country',
    'helper-text': '',
    theme: ''
  };

  function updateCode() {
    const attrs = Object.entries(state)
      .filter(([k, v]) => {
        if (v === false || v === '') return false;
        if (k === 'size' && v === 'md') return false;
        if (k === 'variant' && v === 'default') return false;
        return true;
      })
      .map(([k, v]) => (v === true ? k : `${k}="${v}"`))
      .join('\n  ');

    codeEl.textContent = attrs
      ? `<lt-select\n  ${attrs}\n></lt-select>`
      : `<lt-select label="Country" placeholder="Select a country"></lt-select>`;
  }

  // size & variant & theme
  ['size', 'variant', 'theme'].forEach((id) => {
    document.getElementById(`ctrl-${id}`)?.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      state[id] = val;
      if (val) {
        select.setAttribute(id, val);
      } else {
        select.removeAttribute(id);
      }

      if (id === 'theme') {
        if (val === 'dark' || val === 'light') {
          preview.setAttribute('data-preview-theme', val);
        } else {
          preview.removeAttribute('data-preview-theme');
        }
      }

      updateCode();
    });
  });

  // disabled & required
  ['disabled', 'required'].forEach((id) => {
    document.getElementById(`ctrl-${id}`)?.addEventListener('change', (e) => {
      const checked = (e.target as HTMLInputElement).checked;
      state[id] = checked;
      if (checked) {
        select.setAttribute(id, '');
      } else {
        select.removeAttribute(id);
      }
      updateCode();
    });
  });

  // label & placeholder & helper
  ['label', 'placeholder', 'helper'].forEach((id) => {
    document.getElementById(`ctrl-${id}`)?.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value;
      const attr = id === 'helper' ? 'helper-text' : id;
      state[attr] = val;
      if (val) {
        select.setAttribute(attr, val);
      } else {
        select.removeAttribute(attr);
      }
      updateCode();
    });
  });

  updateCode();
</script>
