---
import BaseLayout from '../../../layouts/BaseLayout/index.astro';
import ComponentPlayground from '../../../components/ComponentPlayground/index.astro';
import FrameworkTabs from '../../../components/FrameworkTabs/index.astro';
import ApiTable from '../../../components/ApiTable/index.astro';
---

<BaseLayout title="Checkbox" description="Checkbox input component">
  <lt-text variant="h1">Checkbox</lt-text>
  <lt-text variant="body"
    >A checkbox input with support for checked, indeterminate, and disabled states across multiple variants.</lt-text
  >

  <lt-text variant="h2">Playground</lt-text>
  <ComponentPlayground tag="lt-checkbox" defaults={{ label: 'Accept terms' }} />

  <lt-text variant="h2">Usage</lt-text>
  <FrameworkTabs
    html={`
<lt-checkbox label="Accept terms and conditions"></lt-checkbox>
<lt-checkbox label="Enable notifications" variant="success" checked></lt-checkbox>
<lt-checkbox label="Unavailable option" disabled></lt-checkbox>

<lt-checkbox id="terms" label="Accept terms and conditions"></lt-checkbox>
<script>
  document.getElementById('terms').addEventListener('change', (e) => {
    console.log('checked:', e.detail.checked);
  });
</script>
    `}
    react={`
import { Checkbox } from '@latty/react';

<Checkbox label="Accept terms and conditions" />
<Checkbox label="Enable notifications" variant="success" checked />
<Checkbox label="Unavailable option" disabled />

<Checkbox
  label="Accept terms and conditions"
  onChange={(e) => console.log('checked:', e.detail.checked)}
/>
    `}
    vue={`
<script setup>
import { ref } from 'vue'
const accepted = ref(false)
</script>

<template>
  <lt-checkbox label="Accept terms and conditions"></lt-checkbox>
  <lt-checkbox label="Enable notifications" variant="success" checked></lt-checkbox>
  <lt-checkbox label="Unavailable option" disabled></lt-checkbox>

  <lt-checkbox
    label="Accept terms and conditions"
    @change="(e) => accepted = e.detail.checked"
  ></lt-checkbox>
</template>
    `}
  />

  <lt-text variant="h2">API</lt-text>
  <ApiTable tag="lt-checkbox" />
</BaseLayout>

<script>
  import '@latty/web';
</script>
