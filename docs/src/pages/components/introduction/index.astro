---
import BaseLayout from '../../../layouts/BaseLayout/index.astro';
import { components } from './_components.data';
---

<BaseLayout
  title="Components overview"
  description="Philosophy, prop naming conventions, and a directory of every component"
>
  <lt-text variant="h1">Components</lt-text>
  <lt-text variant="body">
    Latty components are Lit-based Web Components that consume <code>--lt-*</code> design tokens. They work natively in HTML,
    Vue, and Svelte, and ship with thin React wrappers in <code>@latty/react</code>. Every component follows the same
    prop naming rules so you never have to guess — if you know one component you know them all.
  </lt-text>

  <lt-text variant="h2">Prop naming conventions</lt-text>
  <lt-text variant="body"
    >Each prop name has exactly one meaning across the entire system. The table below is the canonical reference.</lt-text
  >

  <lt-table id="conv-table" hoverable responsive-mode="scroll"></lt-table>

  <lt-text variant="h2">Boolean prop conventions</lt-text>
  <lt-text variant="body">
    A boolean attribute is <code>true</code> when present and <code>false</code> when absent — consistent with how HTML boolean
    attributes work (<code>disabled</code>, <code>required</code>, etc.).
  </lt-text>

  <lt-list>
    <lt-list-item>
      <strong>Positive adjective or noun</strong> — use when the feature is off by default and the attribute enables it:
      <code>disabled</code>, <code>loading</code>, <code>closable</code>, <code>striped</code>, <code>bordered</code>,
      <code>tooltip</code>.
    </lt-list-item>
    <lt-list-item>
      <strong><code>no-</code> prefix</strong> — use when the feature is <em>on</em> by default and the attribute suppresses
      it: <code>no-close-button</code>, <code>no-marker</code>.
    </lt-list-item>
    <lt-list-item>
      <strong>Never verb phrases</strong> — <code>hideCloseButton</code>, <code>showTooltip</code>, <code>withIcon</code
      >
      are banned. They force the reader to reason about polarity instead of just checking presence.
    </lt-list-item>
  </lt-list>

  <lt-text variant="h2">All components</lt-text>

  <div class="component-grid">
    {
      components.map((c) => (
        <a class="component-card" href={c.href}>
          <lt-surface appearance="outlined" elevation="0">
            <div class="card-body">
              <lt-text variant="label">{c.name}</lt-text>
              <lt-chip appearance="outlined" variant="neutral" size="sm">
                {c.tag}
              </lt-chip>
              <lt-text variant="body-sm">{c.desc}</lt-text>
            </div>
          </lt-surface>
        </a>
      ))
    }
  </div>
</BaseLayout>

<style>
  @import './introduction.styles.css';
</style>

<script>
  import '@latty/web';
  import { propConventions, type PropConvention } from './_components.data';

  const table = document.getElementById('conv-table');

  function codeEl(text: string) {
    const el = document.createElement('code');
    el.textContent = text;
    return el;
  }

  function valuesCell(values: string[] | undefined, note: string | undefined) {
    const span = document.createElement('span');
    const parts: string[] = [];
    if (values?.length) parts.push(values.map((v) => `<code>${v}</code>`).join(' · '));
    if (note) parts.push(`<em>${note}</em>`);
    span.innerHTML = parts.join(' — ');
    return span;
  }

  if (table) {
    Object.assign(table, {
      columns: [
        { key: 'prop', label: 'Prop', width: '180px', render: (v: string) => codeEl(v) },
        { key: 'controls', label: 'Controls', width: '220px' },
        {
          key: 'values',
          label: 'Allowed values',
          render: (v: string[], row: PropConvention) => valuesCell(v, row.valuesNote)
        },
        { key: 'usedOn', label: 'Used on' }
      ],
      data: propConventions
    });
  }
</script>
