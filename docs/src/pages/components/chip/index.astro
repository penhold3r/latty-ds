---
import BaseLayout from '../../../layouts/BaseLayout/index.astro';
import ComponentPlayground from '../../../components/ComponentPlayground/index.astro';
import FrameworkTabs from '../../../components/FrameworkTabs/index.astro';
import ApiTable from '../../../components/ApiTable/index.astro';
import VariantPresets from '../../../components/VariantPresets/index.astro';
---

<BaseLayout title="Chip" description="Compact label for tags, filters, and attributes">
  <lt-text variant="h1">Chip</lt-text>
  <lt-text variant="body">Compact pill-shaped labels for tags, filters, status indicators, and attributes.</lt-text>

  <lt-text variant="h2">Playground</lt-text>
  <VariantPresets tag="lt-chip" slotContent="Design System" />
  <ComponentPlayground tag="lt-chip" content="Design System" />

  <lt-text variant="h2">Usage</lt-text>
  <FrameworkTabs
    html={`
<lt-chip variant="primary">Design</lt-chip>
<lt-chip variant="success" appearance="outlined">Active</lt-chip>
<lt-chip variant="error" deletable>Urgent</lt-chip>
    `}
    react={`
import { Chip } from '@latty/react';

<Chip variant="primary">Design</Chip>
<Chip variant="success" appearance="outlined">Active</Chip>
<Chip variant="error" deletable>Urgent</Chip>
    `}
    vue={`
<template>
  <lt-chip variant="primary">Design</lt-chip>
  <lt-chip variant="success" appearance="outlined">Active</lt-chip>
  <lt-chip variant="error" deletable>Urgent</lt-chip>
</template>
    `}
  />

  <lt-text variant="h2">API</lt-text>
  <ApiTable tag="lt-chip" />
</BaseLayout>

<script>
  import '@latty/web';
</script>
