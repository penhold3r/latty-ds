---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ComponentPlayground from '../../../components/ComponentPlayground.astro';
import FrameworkTabs from '../../../components/FrameworkTabs.astro';
import ApiTable from '../../../components/ApiTable.astro';
---

<BaseLayout title="Link" description="A styled anchor element with primary color and optional external-link behaviour.">
  <lt-text variant="h1">Link</lt-text>
  <lt-text variant="body">
    A styled anchor element. Uses the primary color by default with an underline on hover. Set <code>external</code> to open
    in a new tab and display a trailing external-link icon.
  </lt-text>

  <lt-text variant="h2">Playground</lt-text>
  <ComponentPlayground tag="lt-link" content="Visit site" defaults={{ href: 'https://example.com' }} />

  <lt-text variant="h2">Usage</lt-text>
  <FrameworkTabs
    html={`<lt-link href="https://example.com">Visit site</lt-link>
<lt-link href="https://example.com" external>Open in new tab</lt-link>`}
    react={`
import { Link } from '@latty/react';

<Link href="https://example.com">Visit site</Link>
<Link href="https://example.com" external>Open in new tab</Link>
    `}
    vue={`
<template>
  <lt-link href="https://example.com">Visit site</lt-link>
  <lt-link href="https://example.com" external>Open in new tab</lt-link>
</template>
    `}
  />

  <lt-text variant="h2">API</lt-text>
  <ApiTable tag="lt-link" />
</BaseLayout>

<script>
  import '@latty/web';
</script>
