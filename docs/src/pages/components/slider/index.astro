---
import BaseLayout from '../../../layouts/BaseLayout/index.astro';
import ComponentPlayground from '../../../components/ComponentPlayground/index.astro';
import FrameworkTabs from '../../../components/FrameworkTabs/index.astro';
import ApiTable from '../../../components/ApiTable/index.astro';
---

<BaseLayout title="Slider" description="A range input for selecting a numeric value within a bounded range">
  <lt-text variant="h1">Slider</lt-text>
  <lt-text variant="body">
    A styled range input for selecting a numeric value between a minimum and maximum. Supports size variants, labels,
    and exposes <code>lt-input</code> / <code>lt-change</code> events with the current numeric value in the event detail.
  </lt-text>

  <lt-text variant="h2">Playground</lt-text>
  <ComponentPlayground tag="lt-slider" stretch={true} previewHeight="auto" defaults={{ label: 'Volume', value: 40 }} />

  <lt-text variant="h2">Usage</lt-text>
  <FrameworkTabs
    html={`
<lt-slider label="Volume" value="40" min="0" max="100" step="1"></lt-slider>

<!-- Sizes -->
<lt-slider size="sm" label="Small" value="50"></lt-slider>
<lt-slider size="md" label="Medium" value="50"></lt-slider>
<lt-slider size="lg" label="Large" value="50"></lt-slider>

<!-- Show value tooltip -->
<lt-slider label="Volume" value="40" tooltip></lt-slider>

<!-- Disabled -->
<lt-slider label="Disabled" value="60" disabled></lt-slider>

<!-- Listen for events -->
<lt-slider id="vol" label="Volume" value="0"></lt-slider>
<script>
  document.getElementById('vol').addEventListener('lt-input', (e) => {
    console.log('Value:', e.detail.value);
  });
</script>
    `}
    react={`
import { Slider } from '@latty/react';

function VolumeControl() {
  const [volume, setVolume] = useState(40);

  return (
    <Slider
      label="Volume"
      value={volume}
      min={0}
      max={100}
      step={1}
      onLtInput={(e) => setVolume(e.detail.value)}
    />
  );
}
    `}
    vue={`
<script setup>
import { ref } from 'vue'
const volume = ref(40)
</script>

<template>
  <lt-slider
    label="Volume"
    :value="volume"
    :min="0"
    :max="100"
    :step="1"
    @lt-input="volume = $event.detail.value"
  ></lt-slider>
</template>
    `}
  />

  <lt-text variant="h2">API</lt-text>
  <ApiTable tag="lt-slider" />
</BaseLayout>

<script>
  import '@latty/web';
</script>
