---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PlaygroundShell from '../../../components/PlaygroundShell.astro';
import FrameworkTabs from '../../../components/FrameworkTabs.astro';
import ApiTable from '../../../components/ApiTable.astro';
---

<BaseLayout title="Dialog" description="Modal dialog component">
  <lt-text variant="h1">Dialog</lt-text>
  <lt-text variant="body">
    A modal dialog with backdrop, keyboard trap, and focus management. Supports a <code>footer</code> slot for actions. Emits
    <code>lt-open</code> and <code>lt-close</code> events.
  </lt-text>

  <lt-text variant="h2">Playground</lt-text>
  <PlaygroundShell id="dialog-playground">
    <div slot="preview">
      <lt-button variant="primary" id="open-dialog">Open dialog</lt-button>
    </div>
    <div slot="controls">
      <div class="control-row">
        <label class="control-label" for="ctrl-size">size</label>
        <select class="control-select" id="ctrl-size">
          <option value="sm">sm</option>
          <option value="md" selected>md</option>
          <option value="lg">lg</option>
          <option value="xl">xl</option>
        </select>
      </div>
      <div class="control-row">
        <label class="control-label" for="ctrl-hide-close">no-close-button</label>
        <input class="control-toggle" type="checkbox" id="ctrl-hide-close" />
      </div>
      <div class="control-row">
        <label class="control-label" for="ctrl-backdrop">close-on-backdrop-click</label>
        <input class="control-toggle" type="checkbox" id="ctrl-backdrop" checked />
      </div>
      <div class="control-row">
        <label class="control-label" for="ctrl-escape">close-on-escape</label>
        <input class="control-toggle" type="checkbox" id="ctrl-escape" checked />
      </div>
      <div class="control-row">
        <label class="control-label" for="ctrl-uppercase">uppercase</label>
        <input class="control-toggle" type="checkbox" id="ctrl-uppercase" />
      </div>
      <div class="control-row">
        <label class="control-label" for="ctrl-blur">backdrop-blur</label>
        <input class="control-toggle" type="checkbox" id="ctrl-blur" />
      </div>
      <div class="control-row">
        <label class="control-label" for="ctrl-overlay-opacity">overlay-opacity</label>
        <input class="control-input" type="range" min="0" max="1" step="0.05" value="0.5" id="ctrl-overlay-opacity" />
      </div>
    </div>
  </PlaygroundShell>

  <lt-dialog id="playground-dialog" title="Example dialog" size="md">
    <lt-text variant="body"
      >This is the dialog content. Try changing the controls to see how the dialog behaves.</lt-text
    >
    <div slot="footer">
      <lt-button variant="neutral" appearance="outlined" id="cancel-dialog">Cancel</lt-button>
      <lt-button variant="primary">Confirm</lt-button>
    </div>
  </lt-dialog>

  <lt-text variant="h2">Usage</lt-text>
  <FrameworkTabs
    html={`
<lt-button variant="primary" id="open-btn">Open dialog</lt-button>

<lt-dialog id="my-dialog" title="Confirm action" size="sm">
  <p>Are you sure you want to proceed?</p>
  <div slot="footer">
    <lt-button variant="neutral" appearance="outlined" id="cancel-btn">Cancel</lt-button>
    <lt-button variant="primary">Confirm</lt-button>
  </div>
</lt-dialog>

<script type="module">
  const dialog = document.getElementById('my-dialog');
  document.getElementById('open-btn').addEventListener('click', () => dialog.open = true);
  document.getElementById('cancel-btn').addEventListener('click', () => dialog.open = false);
<\/script>
    `}
    react={`
import { useState } from 'react';
import { Dialog, Button } from '@latty/react';

function Example() {
  const [open, setOpen] = useState(false);
  return (
    <>
      <Button variant="primary" onClick={() => setOpen(true)}>
        Open dialog
      </Button>
      <Dialog
        open={open}
        title="Confirm action"
        size="sm"
        onLtDialogClose={() => setOpen(false)}
      >
        <p>Are you sure you want to proceed?</p>
        <div slot="footer">
          <Button variant="neutral" appearance="outlined"
            onClick={() => setOpen(false)}>Cancel</Button>
          <Button variant="primary">Confirm</Button>
        </div>
      </Dialog>
    </>
  );
}
    `}
    vue={`
<script setup lang="ts">
import { ref } from 'vue'
const open = ref(false)
</script>

<template>
  <lt-button variant="primary" @click="open = true">Open dialog</lt-button>

  <lt-dialog :open="open" title="Confirm action" size="sm"
    @lt-dialog-close="open = false">
    <p>Are you sure you want to proceed?</p>
    <div slot="footer">
      <lt-button variant="neutral" appearance="outlined"
        @click="open = false">Cancel</lt-button>
      <lt-button variant="primary">Confirm</lt-button>
    </div>
  </lt-dialog>
</template>
    `}
  />

  <lt-text variant="h2">API</lt-text>
  <ApiTable tag="lt-dialog" />
</BaseLayout>

<script>
  import '@latty/web';

  const dialog = document.getElementById('playground-dialog') as any;
  const codeEl = document.getElementById('dialog-playground-code')!;

  const state = {
    size: 'md',
    'no-close-button': false,
    'close-on-backdrop-click': true,
    'close-on-escape': true,
    uppercase: false,
    'backdrop-blur': false,
    'overlay-opacity': 0.5 as number
  };

  function updateCode() {
    const attrs = Object.entries(state)
      .filter(([k, v]) => v !== false && !(k === 'size' && v === 'md') && !(k === 'overlay-opacity' && v === 0.5))
      .map(([k, v]) => (v === true ? k : `${k}="${v}"`))
      .join('\n  ');
    codeEl.textContent = attrs
      ? `<lt-dialog\n  ${attrs}\n  title="Example dialog"\n></lt-dialog>`
      : `<lt-dialog title="Example dialog"></lt-dialog>`;
  }

  document.getElementById('open-dialog')?.addEventListener('click', () => (dialog.open = true));
  document.getElementById('cancel-dialog')?.addEventListener('click', () => (dialog.open = false));

  document.getElementById('ctrl-size')?.addEventListener('change', (e) => {
    state.size = (e.target as HTMLSelectElement).value;
    dialog.setAttribute('size', state.size);
    updateCode();
  });

  [
    ['ctrl-hide-close', 'no-close-button'],
    ['ctrl-backdrop', 'close-on-backdrop-click'],
    ['ctrl-escape', 'close-on-escape'],
    ['ctrl-uppercase', 'uppercase'],
    ['ctrl-blur', 'backdrop-blur']
  ].forEach(([ctrlId, attr]) => {
    document.getElementById(ctrlId)?.addEventListener('change', (e) => {
      const checked = (e.target as HTMLInputElement).checked;
      (state as any)[attr] = checked;
      if (checked) {
        dialog.setAttribute(attr, '');
      } else {
        dialog.removeAttribute(attr);
      }
      updateCode();
    });
  });

  document.getElementById('ctrl-overlay-opacity')?.addEventListener('input', (e) => {
    state['overlay-opacity'] = parseFloat((e.target as HTMLInputElement).value);
    dialog.overlayOpacity = state['overlay-opacity'];
    updateCode();
  });

  updateCode();
</script>
