---
import BaseLayout from '../../../layouts/BaseLayout/index.astro';
import ComponentPlayground from '../../../components/ComponentPlayground/index.astro';
import FrameworkTabs from '../../../components/FrameworkTabs/index.astro';
import ApiTable from '../../../components/ApiTable/index.astro';
---

<BaseLayout title="Dialog" description="Modal dialog component">
  <lt-text variant="h1">Dialog</lt-text>
  <lt-text variant="body">
    A modal dialog with backdrop, keyboard trap, and focus management. Supports a <code>footer</code> slot for actions. Emits
    <code>open</code> and <code>close</code> events.
  </lt-text>

  <lt-text variant="h2">Playground</lt-text>
  <ComponentPlayground
    tag="lt-dialog"
    previewTrigger="Open dialog"
    defaults={{ title: 'Example dialog', 'close-on-backdrop-click': true, 'close-on-escape': true }}
    content={`<lt-text variant="body">This is the dialog content. Try changing the controls to see how the dialog behaves.</lt-text>
<div slot="footer">
  <lt-button variant="neutral" appearance="outlined" data-action="close">Cancel</lt-button>
  <lt-button variant="primary" data-action="close">Confirm</lt-button>
</div>`}
  />

  <lt-text variant="h2">Usage</lt-text>
  <FrameworkTabs
    html={`
<lt-button variant="primary" id="open-btn">Open dialog</lt-button>

<lt-dialog id="my-dialog" title="Confirm action" size="sm">
  <lt-text>Are you sure you want to proceed?</lt-text>
  <div slot="footer">
    <lt-button variant="neutral" appearance="outlined" id="cancel-btn">Cancel</lt-button>
    <lt-button variant="primary">Confirm</lt-button>
  </div>
</lt-dialog>

<script type="module">
  const dialog = document.getElementById('my-dialog');
  document.getElementById('open-btn').addEventListener('click', () => dialog.open = true);
  document.getElementById('cancel-btn').addEventListener('click', () => dialog.open = false);
<\/script>
    `}
    react={`
import { useState } from 'react';
import { Dialog, Button, Text } from '@latty/react';

function Example() {
  const [open, setOpen] = useState(false);
  return (
    <>
      <Button variant="primary" onClick={() => setOpen(true)}>
        Open dialog
      </Button>
      <Dialog
        open={open}
        title="Confirm action"
        size="sm"
        onClose={() => setOpen(false)}
      >
        <Text>Are you sure you want to proceed?</Text>
        <div slot="footer">
          <Button variant="neutral" appearance="outlined"
            onClick={() => setOpen(false)}>Cancel</Button>
          <Button variant="primary">Confirm</Button>
        </div>
      </Dialog>
    </>
  );
}
    `}
    vue={`
<script setup lang="ts">
import { ref } from 'vue'
const open = ref(false)
</script>

<template>
  <lt-button variant="primary" @click="open = true">Open dialog</lt-button>

  <lt-dialog :open="open" title="Confirm action" size="sm"
    @close="open = false">
    <lt-text>Are you sure you want to proceed?</lt-text>
    <div slot="footer">
      <lt-button variant="neutral" appearance="outlined"
        @click="open = false">Cancel</lt-button>
      <lt-button variant="primary">Confirm</lt-button>
    </div>
  </lt-dialog>
</template>
    `}
  />

  <lt-text variant="h2">API</lt-text>
  <ApiTable tag="lt-dialog" />
</BaseLayout>

<script>
  import '@latty/web';
</script>
