---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PlaygroundShell from '../../../components/PlaygroundShell.astro';
import FrameworkTabs from '../../../components/FrameworkTabs.astro';
import ApiTable from '../../../components/ApiTable.astro';
---

<BaseLayout title="Snackbar" description="Brief notification that appears temporarily at the bottom of the viewport">
  <lt-text variant="h1">Snackbar</lt-text>
  <lt-text variant="body">
    A brief, non-blocking notification anchored to the bottom of the viewport. Snackbars auto-dismiss after a
    configurable delay and can optionally include an action button. Use them for short feedback messages —
    confirmations, undo prompts, or transient alerts.
  </lt-text>

  <lt-text variant="h2">Playground</lt-text>
  <PlaygroundShell id="snackbar-playground" previewHeight="auto">
    <div slot="preview">
      <lt-button variant="primary" id="show-snackbar">Show snackbar</lt-button>
    </div>
    <div slot="controls">
      <div class="control-row">
        <label class="control-label" for="ctrl-variant">variant</label>
        <select class="control-select" id="ctrl-variant">
          <option value="default" selected>default</option>
          <option value="success">success</option>
          <option value="warning">warning</option>
          <option value="error">error</option>
          <option value="info">info</option>
        </select>
      </div>
      <div class="control-row">
        <label class="control-label" for="ctrl-action">action-label</label>
        <input class="control-input" type="text" id="ctrl-action" placeholder="e.g. Undo" />
      </div>
      <div class="control-row">
        <label class="control-label" for="ctrl-duration">duration (ms)</label>
        <input class="control-input" type="number" id="ctrl-duration" value="4000" min="0" step="500" />
      </div>
      <div class="control-row">
        <label class="control-label" for="ctrl-closable">closable</label>
        <input class="control-toggle" type="checkbox" id="ctrl-closable" checked />
      </div>
      <div class="control-row">
        <label class="control-label" for="ctrl-icon">icon</label>
        <input class="control-input" type="text" id="ctrl-icon" placeholder="e.g. check or none" />
      </div>
    </div>
  </PlaygroundShell>

  <lt-snackbar id="playground-snackbar" variant="default" duration="4000">Changes saved successfully</lt-snackbar>

  <lt-text variant="h2">Usage</lt-text>
  <FrameworkTabs
    html={`
<lt-snackbar id="sb">Changes saved</lt-snackbar>
<lt-button onclick="document.getElementById('sb').show()">Save</lt-button>

<lt-snackbar variant="success">Upload complete</lt-snackbar>
<lt-snackbar variant="warning">Low disk space</lt-snackbar>
<lt-snackbar variant="error">Request failed</lt-snackbar>
<lt-snackbar variant="info">Update available</lt-snackbar>

<lt-snackbar action-label="Undo">Message deleted</lt-snackbar>

<lt-snackbar duration="0" variant="warning">You are offline</lt-snackbar>
    `}
    react={`
import { useRef } from 'react';
import { Snackbar, Button } from '@latty/react';
import type { Snackbar as SnackbarEl } from '@latty/web';

function Example() {
  const ref = useRef<SnackbarEl>(null);
  return (
    <>
      <Button variant="primary" onClick={() => ref.current?.show()}>Save</Button>
      <Snackbar ref={ref} variant="success" actionLabel="Undo">
        Changes saved
      </Snackbar>
    </>
  );
}
    `}
    vue={`
<script setup>
import { ref } from 'vue'
const snackbar = ref(null)
</script>

<template>
  <lt-button variant="primary" @click="snackbar?.show()">Save</lt-button>
  <lt-snackbar ref="snackbar" variant="success" action-label="Undo">
    Changes saved
  </lt-snackbar>
</template>
    `}
  />

  <lt-text variant="h2">Snackbar vs. Alert</lt-text>
  <lt-text variant="body">Both communicate feedback to the user, but they serve different moments:</lt-text>
  <table class="compare-table" aria-label="Snackbar vs. Alert comparison">
    <thead><tr><th scope="col" aria-label="Property"></th><th>Snackbar</th><th>Alert</th></tr></thead>
    <tbody>
      <tr
        ><td><strong>Position</strong></td><td>Fixed overlay, bottom of viewport</td><td>Inline, within page flow</td
        ></tr
      >
      <tr
        ><td><strong>Lifetime</strong></td><td>Transient — auto-dismisses after a configurable delay</td><td
          >Persistent — stays until dismissed or condition resolves</td
        ></tr
      >
      <tr
        ><td><strong>Use when</strong></td><td
          >Confirming the result of an action the user just took (saved, deleted, copied)</td
        ><td>The message is tied to a specific location on the page (a form, a section, a card)</td></tr
      >
      <tr
        ><td><strong>Avoid when</strong></td><td>The user needs to read and act on the message before continuing</td><td
          >The message is a response to a one-off action and doesn't need to persist</td
        ></tr
      >
    </tbody>
  </table>

  <lt-text variant="h2">API</lt-text>
  <ApiTable tag="lt-snackbar" />
</BaseLayout>

<script>
  import '@latty/web';

  const snackbar = document.getElementById('playground-snackbar') as any;
  const codeEl = document.getElementById('snackbar-playground-code')!;

  const state: Record<string, string | boolean | number> = {
    variant: 'default',
    'action-label': '',
    duration: 4000,
    closable: true,
    icon: ''
  };

  function applyState() {
    snackbar.variant = state.variant as string;
    snackbar.duration = state.duration as number;
    snackbar.closable = state.closable as boolean;
    if (state['action-label']) {
      snackbar.setAttribute('action-label', state['action-label'] as string);
    } else {
      snackbar.removeAttribute('action-label');
    }
    snackbar.icon = state.icon as string;
  }

  function updateCode() {
    const attrs: string[] = [];
    if (state.variant !== 'default') attrs.push(`variant="${state.variant}"`);
    if (state['action-label']) attrs.push(`action-label="${state['action-label']}"`);
    if (state.duration !== 4000) attrs.push(`duration="${state.duration}"`);
    if (!state.closable) attrs.push(`closable="false"`);
    if (state.icon) attrs.push(`icon="${state.icon}"`);
    const attrsStr = attrs.length ? '\n  ' + attrs.join('\n  ') + '\n' : '';
    codeEl.textContent = `<lt-snackbar${attrsStr}>Changes saved successfully</lt-snackbar>`;
  }

  document.getElementById('show-snackbar')?.addEventListener('click', () => {
    applyState();
    snackbar.show();
  });

  document.getElementById('ctrl-variant')?.addEventListener('change', (e) => {
    state.variant = (e.target as HTMLSelectElement).value;
    updateCode();
  });

  document.getElementById('ctrl-action')?.addEventListener('input', (e) => {
    state['action-label'] = (e.target as HTMLInputElement).value;
    updateCode();
  });

  document.getElementById('ctrl-duration')?.addEventListener('input', (e) => {
    state.duration = Number((e.target as HTMLInputElement).value);
    updateCode();
  });

  document.getElementById('ctrl-closable')?.addEventListener('change', (e) => {
    state.closable = (e.target as HTMLInputElement).checked;
    updateCode();
  });

  document.getElementById('ctrl-icon')?.addEventListener('input', (e) => {
    state.icon = (e.target as HTMLInputElement).value;
    updateCode();
  });

  updateCode();
</script>
