---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FrameworkTabs from '../../../components/FrameworkTabs.astro';
import ApiTable from '../../../components/ApiTable.astro';
import PlaygroundShell from '../../../components/PlaygroundShell.astro';
---

<BaseLayout title="Divider" description="A visual separator between content sections.">
  <lt-text variant="h1">Divider</lt-text>
  <lt-text variant="body">
    A thin line that separates content. Supports horizontal and vertical orientations, dashed and dotted styles, and an
    optional centered label.
  </lt-text>

  <lt-text variant="h2">Playground</lt-text>
  <PlaygroundShell id="divider-playground" previewHeight="auto">
    <div
      slot="preview"
      id="playground-container"
      style="width:100%;padding:2rem;display:flex;justify-content:center;align-items:center;"
    >
      <lt-divider id="playground-divider" style="width:100%"></lt-divider>
    </div>
    <div slot="controls">
      <div class="control-row">
        <label class="control-label" for="ctrl-orientation">orientation</label>
        <select class="control-select" id="ctrl-orientation">
          <option value="horizontal" selected>horizontal</option>
          <option value="vertical">vertical</option>
        </select>
      </div>
      <div class="control-row">
        <label class="control-label" for="ctrl-appearance">appearance</label>
        <select class="control-select" id="ctrl-appearance">
          <option value="solid" selected>solid</option>
          <option value="dashed">dashed</option>
          <option value="dotted">dotted</option>
        </select>
      </div>
      <div class="control-row">
        <label class="control-label" for="ctrl-label">label</label>
        <input class="control-text" type="text" id="ctrl-label" placeholder="Optional label" />
      </div>
      <div class="control-row">
        <label class="control-label" for="ctrl-theme">theme</label>
        <select class="control-select" id="ctrl-theme">
          <option value="" selected>default</option>
          <option value="light">light</option>
          <option value="dark">dark</option>
        </select>
      </div>
    </div>
  </PlaygroundShell>

  <lt-text variant="h2">Usage</lt-text>
  <FrameworkTabs
    html={`<!-- Horizontal (default) -->
<lt-divider></lt-divider>

<!-- With label -->
<lt-divider label="or"></lt-divider>

<!-- Line styles -->
<lt-divider appearance="dashed"></lt-divider>
<lt-divider appearance="dotted"></lt-divider>

<!-- Vertical -->
<div style="display:flex;height:48px;align-items:stretch;">
  <span>Left</span>
  <lt-divider orientation="vertical"></lt-divider>
  <span>Right</span>
</div>`}
    react={`import { Divider } from '@latty/react';

<Divider />
<Divider label="or" />
<Divider appearance="dashed" />
<Divider orientation="vertical" />`}
    vue={`<template>
  <lt-divider></lt-divider>
  <lt-divider label="or"></lt-divider>
  <lt-divider appearance="dashed"></lt-divider>
  <lt-divider orientation="vertical"></lt-divider>
</template>`}
  />

  <lt-text variant="h2">API</lt-text>
  <ApiTable tag="lt-divider" />
</BaseLayout>

<script>
  import '@latty/web';

  const divider = document.getElementById('playground-divider') as any;
  const container = document.getElementById('playground-container')!;
  const playground = document.getElementById('divider-playground')!;
  const preview = playground.querySelector('.preview')!;
  const codeEl = document.getElementById('divider-playground-code')!;

  const state: Record<string, any> = {
    orientation: 'horizontal',
    appearance: 'solid',
    label: '',
    theme: ''
  };

  function updateCode() {
    const attrs = Object.entries(state)
      .filter(([k, v]) => {
        if (v === false || v === '') return false;
        if (k === 'orientation' && v === 'horizontal') return false;
        if (k === 'appearance' && v === 'solid') return false;
        return true;
      })
      .map(([k, v]) => (v === true ? k : `${k}="${v}"`))
      .join(' ');

    codeEl.textContent = `<lt-divider${attrs ? ' ' + attrs : ''}></lt-divider>`;
  }

  // select controls
  ['orientation', 'appearance', 'theme'].forEach((id) => {
    document.getElementById(`ctrl-${id}`)?.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      state[id] = val;

      if (val) {
        divider.setAttribute(id, val);
      } else {
        divider.removeAttribute(id);
      }

      if (id === 'orientation') {
        if (val === 'vertical') {
          container.style.height = '120px';
          container.style.alignItems = 'stretch';
          divider.style.width = 'auto';
        } else {
          container.style.height = 'auto';
          container.style.alignItems = 'center';
          divider.style.width = '100%';
        }
      }

      if (id === 'theme') {
        if (val === 'dark' || val === 'light') {
          preview.setAttribute('data-preview-theme', val);
        } else {
          preview.removeAttribute('data-preview-theme');
        }
      }

      updateCode();
    });
  });

  // text control
  document.getElementById('ctrl-label')?.addEventListener('input', (e) => {
    const val = (e.target as HTMLInputElement).value;
    state.label = val;
    if (val) {
      divider.setAttribute('label', val);
    } else {
      divider.removeAttribute('label');
    }
    updateCode();
  });

  updateCode();
</script>
