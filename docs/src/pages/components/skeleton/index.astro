---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FrameworkTabs from '../../../components/FrameworkTabs.astro';
import ApiTable from '../../../components/ApiTable.astro';
import PlaygroundShell from '../../../components/PlaygroundShell.astro';
---

<BaseLayout title="Skeleton" description="A loading placeholder that mimics the shape of content.">
  <lt-text variant="h1">Skeleton</lt-text>
  <lt-text variant="body">
    A shimmering placeholder used while content is loading. Matches the shape of the real content to reduce layout shift
    and signal progress to the user.
  </lt-text>

  <lt-text variant="h2">Playground</lt-text>
  <PlaygroundShell id="skeleton-playground" previewHeight="auto">
    <div slot="preview" style="display:flex;flex-direction:column;gap:1rem;padding:1.5rem;max-width:320px;">
      <div style="display:flex;align-items:center;gap:0.75rem;">
        <lt-skeleton shape="circle" width="40px" height="40px"></lt-skeleton>
        <div style="flex:1;display:flex;flex-direction:column;gap:0.5rem;">
          <lt-skeleton shape="text" width="60%"></lt-skeleton>
          <lt-skeleton shape="text" width="40%"></lt-skeleton>
        </div>
      </div>
      <lt-skeleton height="120px"></lt-skeleton>
      <lt-skeleton shape="text"></lt-skeleton>
      <lt-skeleton shape="text" width="80%"></lt-skeleton>
    </div>
    <div slot="controls"></div>
  </PlaygroundShell>

  <lt-text variant="h2">Usage</lt-text>
  <FrameworkTabs
    html={`<!-- Default rect -->
<lt-skeleton></lt-skeleton>
<lt-skeleton height="200px"></lt-skeleton>

<!-- Text line -->
<lt-skeleton shape="text" width="60%"></lt-skeleton>

<!-- Avatar circle -->
<lt-skeleton shape="circle" width="48px" height="48px"></lt-skeleton>

<!-- Disable shimmer -->
<lt-skeleton animated="false"></lt-skeleton>`}
    react={`import { Skeleton } from '@latty/react';

<Skeleton />
<Skeleton height="200px" />
<Skeleton shape="text" width="60%" />
<Skeleton shape="circle" width="48px" height="48px" />`}
    vue={`<template>
  <lt-skeleton></lt-skeleton>
  <lt-skeleton height="200px"></lt-skeleton>
  <lt-skeleton shape="text" width="60%"></lt-skeleton>
  <lt-skeleton shape="circle" width="48px" height="48px"></lt-skeleton>
</template>`}
  />

  <lt-text variant="h2">API</lt-text>
  <ApiTable tag="lt-skeleton" />
</BaseLayout>

<script>
  import '@latty/web';
</script>
