---
import BaseLayout from '../../layouts/BaseLayout/index.astro';
import CodeSnippet from '../../components/CodeSnippet/index.astro';
import tokens from '@latty/tokens/tokens.json';

const spacing = (tokens as any).spacing;
const steps = Object.keys(spacing.rem).sort((a, b) => Number(a) - Number(b));

const rows = steps.map((step) => ({
  step,
  varName: step === '0' ? '--lt-spacing-0' : `--lt-spacing-${step}`,
  rem: spacing.rem[step],
  px: spacing.px[step],
  barPx: Math.min(Number(step) * 4, 320)
}));
---

<BaseLayout title="Spacing" description="Spacing tokens in the Latty Design System">
  <lt-text variant="h1">Spacing</lt-text>
  <lt-text variant="body">
    A 4px grid system with 25 steps (0–24), providing 0px to 96px in 4px increments. Each step is available in both <code
      >rem</code
    > (canonical) and <code>px</code> units.
  </lt-text>

  <lt-table id="spacing-table" data={JSON.stringify(rows)} density="compact" hoverable></lt-table>

  <lt-text variant="h2">Usage</lt-text>
  <div class="usage-grid">
    <div class="usage-card">
      <lt-text variant="h3">CSS</lt-text>
      <CodeSnippet
        lang="css"
        code={`.element {
  padding: var(--lt-spacing-4);    /* 1rem / 16px */
  margin-bottom: var(--lt-spacing-6); /* 1.5rem / 24px */
  gap: var(--lt-spacing-3);        /* 0.75rem / 12px */
}`}
      />
    </div>
    <div class="usage-card">
      <lt-text variant="h3">Pixel variant</lt-text>
      <CodeSnippet
        lang="css"
        code={`.element {
  /* use -px- variant for pixel-precise values */
  border-width: var(--lt-spacing-px-1); /* 4px */
  min-height: var(--lt-spacing-px-10);  /* 40px */
}`}
      />
    </div>
  </div>
</BaseLayout>

<style>
  #spacing-table {
    border: 1px solid var(--lt-color-neutral-200);
    border-radius: 8px;
    font-size: 0.8125rem;
    margin: var(--lt-spacing-6) 0;
  }

  .usage-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--lt-spacing-4);
    margin-top: var(--lt-spacing-6);
  }

  @media (max-width: 640px) {
    .usage-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import '@latty/web';

  const el = document.getElementById('spacing-table') as any;
  if (el) {
    el.columns = [
      {
        key: 'step',
        label: 'Step',
        width: '52px',
        align: 'right',
        render(v: unknown) {
          const span = document.createElement('span');
          span.style.cssText = 'font-weight: 600; color: var(--lt-color-neutral-500);';
          span.textContent = String(v);
          return span;
        }
      },
      {
        key: 'varName',
        label: 'CSS variable',
        width: '196px',
        render(v: unknown) {
          const code = document.createElement('code');
          code.style.cssText = 'color: var(--lt-color-primary-700); font-size: 0.8rem; white-space: nowrap;';
          code.textContent = String(v);
          return code;
        }
      },
      {
        key: 'rem',
        label: 'Value',
        width: '72px',
        hideOnMobile: true,
        render(v: unknown) {
          const span = document.createElement('span');
          span.style.cssText = 'font-family: monospace; color: var(--lt-color-neutral-700);';
          span.textContent = String(v);
          return span;
        }
      },
      {
        key: 'px',
        label: 'px',
        width: '60px',
        hideOnMobile: true,
        render(v: unknown) {
          const span = document.createElement('span');
          span.style.cssText = 'font-family: monospace; color: var(--lt-color-neutral-500);';
          span.textContent = String(v);
          return span;
        }
      },
      {
        key: 'barPx',
        label: 'Visual',
        render(v: unknown) {
          const wrap = document.createElement('div');
          wrap.style.cssText = 'display: flex; align-items: center;';
          const bar = document.createElement('div');
          bar.style.cssText = `height: 8px; background: var(--lt-color-primary-400); border-radius: 2px; min-width: 2px; width: ${Math.max(Number(v), 2)}px;`;
          wrap.appendChild(bar);
          return wrap;
        }
      }
    ];
  }
</script>
