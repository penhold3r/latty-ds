---
import BaseLayout from '../../layouts/BaseLayout/index.astro';
import CodeSnippet from '../../components/CodeSnippet/index.astro';
import tokens from '@latty-ds/tokens/tokens.json';

type TokenEntry = [string, string];

const semantic = (tokens as any).semantic as Record<string, string>;

const groups: Record<string, TokenEntry[]> = {
  text: [],
  bg: [],
  border: [],
  interactive: []
};

for (const entry of Object.entries(semantic).sort(([a], [b]) => a.localeCompare(b))) {
  const [key] = entry;
  if (key.startsWith('text-')) groups.text.push(entry);
  else if (key.startsWith('bg-')) groups.bg.push(entry);
  else if (key.startsWith('border-')) groups.border.push(entry);
  else groups.interactive.push(entry);
}

const groupMeta: Record<string, { label: string; description: string }> = {
  text: {
    label: 'Text',
    description: 'Foreground / text colors. Use these instead of raw color steps for typography.'
  },
  bg: { label: 'Background', description: 'Surface and fill colors for layouts, cards, and status regions.' },
  border: { label: 'Border', description: 'Stroke colors for inputs, dividers, and focus rings.' },
  interactive: {
    label: 'Interactive',
    description: 'Hover and active state backgrounds for buttons and clickable elements.'
  }
};
---

<BaseLayout title="Semantic Tokens" description="Intent-based tokens that reference the primitive palette">
  <lt-text variant="h1">Semantic Tokens</lt-text>
  <lt-text variant="body">
    Semantic tokens express <strong>intent</strong> rather than raw values. They reference primitive tokens via <code
      >var()</code
    >, so theming only requires redefining this layer — not touching component code.
  </lt-text>
  <lt-text variant="body">Import in your stylesheet:</lt-text>
  <CodeSnippet lang="css" code="@import '@latty-ds/tokens/semantic.css';" />
  <lt-text variant="body">Or generate them at runtime with your own color palette:</lt-text>
  <CodeSnippet
    lang="js"
    code={`import { configure } from '@latty-ds/tokens/configure';\n\nconfigure({ colors: { primary: '#6366f1' } });`}
  />

  {
    Object.entries(groups).map(([groupKey, entries]) => {
      const meta = groupMeta[groupKey];
      const rows = entries.map(([tok, ref]) => ({ tok, ref }));
      return (
        <section style="margin-top: 2.5rem;">
          <lt-text variant="h2">{meta.label}</lt-text>
          <lt-text variant="body">{meta.description}</lt-text>
          <lt-table class="token-table" data={JSON.stringify(rows)} density="compact" />
        </section>
      );
    })
  }
</BaseLayout>

<style>
  lt-table.token-table {
    border: 1px solid var(--lt-color-neutral-200);
    border-radius: 8px;
    font-size: 0.875rem;
    margin-top: 1rem;
  }
</style>

<script>
  import '@latty-ds/web';

  document.querySelectorAll<any>('lt-table.token-table').forEach((el) => {
    el.columns = [
      {
        key: 'tok',
        label: 'Token',
        render(v: unknown) {
          const code = document.createElement('code');
          code.style.fontFamily = 'monospace';
          code.textContent = `--lt-${v}`;
          return code;
        }
      },
      {
        key: 'ref',
        label: 'References',
        render(v: unknown) {
          const code = document.createElement('code');
          code.style.fontFamily = 'monospace';
          code.textContent = `var(--lt-${v})`;
          return code;
        }
      },
      {
        key: 'ref',
        label: 'Preview',
        render(v: unknown) {
          const span = document.createElement('span');
          span.style.cssText = `display: inline-block; width: 28px; height: 28px; border-radius: 6px; vertical-align: middle; background: var(--lt-${v}); border: 1px solid var(--lt-color-neutral-200);`;
          return span;
        }
      }
    ];
  });
</script>
