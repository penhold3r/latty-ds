---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RecipePreview from '../../../components/RecipePreview.astro';
import FrameworkTabs from '../../../components/FrameworkTabs.astro';
---

<BaseLayout
  title="Content Card"
  description="A media card with image, category badge, title, excerpt, and a call-to-action button."
>
  <h1>Content Card</h1>
  <p>
    A versatile media card for articles, products, or resources — combines a cover image with category tagging and a
    clear call to action.
  </p>

  <h2>Preview</h2>
  <RecipePreview>
    <lt-surface class="content-card" variant="outlined" elevation="1" style="max-width: 300px; display: block;">
      <img
        src="https://picsum.photos/seed/content-card/600/360"
        alt="Card cover"
        style="width: 100%; height: 170px; object-fit: cover; display: block;"
      />
      <div style="padding: var(--lt-spacing-5); display: flex; flex-direction: column; gap: var(--lt-spacing-3);">
        <lt-badge content="Design"></lt-badge>
        <lt-text variant="h5" style="color: var(--lt-color-neutral-900);">Building with design tokens</lt-text>
        <lt-text variant="body-sm" style="color: var(--lt-color-neutral-600);">
          Design tokens are the single source of truth for every visual decision in your product.
        </lt-text>
        <lt-button variant="primary" size="sm" appearance="outlined">Read more</lt-button>
      </div>
    </lt-surface>
  </RecipePreview>

  <h2>Code</h2>
  <FrameworkTabs
    html={`<lt-surface class="content-card" variant="outlined" elevation="1" style="max-width: 300px; display: block;">
  <img
    src="https://picsum.photos/seed/content-card/600/360"
    alt="Card cover"
    style="width: 100%; height: 170px; object-fit: cover; display: block;"
  />
  <div style="padding: var(--lt-spacing-5); display: flex; flex-direction: column; gap: var(--lt-spacing-3);">
    <lt-badge content="Design"></lt-badge>
    <lt-text variant="h5" style="color: var(--lt-color-neutral-900);">Building with design tokens</lt-text>
    <lt-text variant="body-sm" style="color: var(--lt-color-neutral-600);">
      Design tokens are the single source of truth for every visual decision in your product.
    </lt-text>
    <lt-button variant="primary" size="sm" appearance="outlined">Read more</lt-button>
  </div>
</lt-surface>

<style>
  /* clip image to the surface's rounded corners */
  .content-card::part(surface) {
    overflow: hidden;
    border-radius: 12px;
  }
</style>`}
    react={`import { Surface, Badge, Text, Button } from '@latty/react';
import styles from './ContentCard.module.css';

export default function ContentCard() {
  return (
    <Surface
      className={styles.card}
      variant="outlined"
      elevation="1"
      style={{ maxWidth: 300, display: 'block' }}
    >
      <img
        src="https://picsum.photos/seed/content-card/600/360"
        alt="Card cover"
        style={{ width: '100%', height: 170, objectFit: 'cover', display: 'block' }}
      />
      <div style={{ padding: 'var(--lt-spacing-5)', display: 'flex', flexDirection: 'column', gap: 'var(--lt-spacing-3)' }}>
        <Badge content="Design" />
        <Text variant="h5" style={{ color: 'var(--lt-color-neutral-900)' }}>
          Building with design tokens
        </Text>
        <Text variant="body-sm" style={{ color: 'var(--lt-color-neutral-600)' }}>
          Design tokens are the single source of truth for every visual decision in your product.
        </Text>
        <Button variant="primary" size="sm" appearance="outlined">Read more</Button>
      </div>
    </Surface>
  );
}

/* ContentCard.module.css */
/*
.card::part(surface) {
  overflow: hidden;
  border-radius: 12px;
}
*/`}
    vue={`<template>
  <lt-surface
    class="content-card"
    variant="outlined"
    elevation="1"
    style="max-width: 300px; display: block;"
  >
    <img
      src="https://picsum.photos/seed/content-card/600/360"
      alt="Card cover"
      style="width: 100%; height: 170px; object-fit: cover; display: block;"
    />
    <div style="padding: var(--lt-spacing-5); display: flex; flex-direction: column; gap: var(--lt-spacing-3);">
      <lt-badge content="Design"></lt-badge>
      <lt-text variant="h5" style="color: var(--lt-color-neutral-900);">Building with design tokens</lt-text>
      <lt-text variant="body-sm" style="color: var(--lt-color-neutral-600);">
        Design tokens are the single source of truth for every visual decision in your product.
      </lt-text>
      <lt-button variant="primary" size="sm" appearance="outlined">Read more</lt-button>
    </div>
  </lt-surface>
</template>

<style scoped>
  .content-card::part(surface) {
    overflow: hidden;
    border-radius: 12px;
  }
</style>`}
  />

  <h2>Components</h2>
  <p><code>lt-surface</code>, <code>lt-badge</code>, <code>lt-text</code>, <code>lt-button</code></p>
</BaseLayout>

<script>
  import '@latty/web';
  import '@latty/icons';
</script>

<style>
  .content-card::part(surface) {
    overflow: hidden;
    border-radius: 12px;
  }
</style>
