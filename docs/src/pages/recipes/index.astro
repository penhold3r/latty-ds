---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Recipes" description="Copy-paste patterns composed from Latty primitives">
  <lt-text variant="h1">Recipes</lt-text>
  <lt-text variant="body">
    Recipes are complete UI patterns built entirely from Latty primitives — no custom CSS required. They are starting
    points, not constraints. Copy the snippet, adapt the structure, and make it your own.
  </lt-text>

  <div class="recipe-grid">
    <a class="recipe-card" href="/recipes/login-form">
      <lt-surface elevation="1">
        <lt-text variant="label">Login Form</lt-text>
        <lt-text variant="caption">Sign-in form with email, password, remember me, and forgot password link</lt-text>
      </lt-surface>
    </a>
    <a class="recipe-card" href="/recipes/profile-card">
      <lt-surface elevation="1">
        <lt-text variant="label">Profile Card</lt-text>
        <lt-text variant="caption">User profile widget with avatar, name, role, skill tags, and action buttons</lt-text>
      </lt-surface>
    </a>
    <a class="recipe-card" href="/recipes/content-card">
      <lt-surface elevation="1">
        <lt-text variant="label">Content Card</lt-text>
        <lt-text variant="caption">Media card with image, category badge, title, excerpt, and a call-to-action</lt-text>
      </lt-surface>
    </a>
    <a class="recipe-card" href="/recipes/hero-banner">
      <lt-surface elevation="1">
        <lt-text variant="label">Hero Banner</lt-text>
        <lt-text variant="caption"
          >Full-width banner with background overlay, headline, subtext, and CTA buttons</lt-text
        >
      </lt-surface>
    </a>
    <a class="recipe-card" href="/recipes/stats-widget">
      <lt-surface elevation="1">
        <lt-text variant="label">Stats Widget</lt-text>
        <lt-text variant="caption">Dashboard metrics panel with icon, value, label, and progress bar per stat</lt-text>
      </lt-surface>
    </a>
    <a class="recipe-card" href="/recipes/empty-state">
      <lt-surface elevation="1">
        <lt-text variant="label">Empty State</lt-text>
        <lt-text variant="caption">Zero-data placeholder with icon circle, message, and a call to action</lt-text>
      </lt-surface>
    </a>
  </div>
</BaseLayout>

<style>
  .recipe-grid {
    display: grid;
    gap: var(--lt-spacing-4);
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    margin-top: var(--lt-spacing-6);
  }

  .recipe-card {
    color: inherit;
    text-decoration: none;
  }

  .recipe-card lt-surface::part(surface) {
    display: flex;
    flex-direction: column;
    gap: var(--lt-spacing-2);
    height: 100%;
    padding: var(--lt-spacing-5);
    transition: box-shadow 150ms ease;
  }

  .recipe-card:hover lt-surface::part(surface) {
    box-shadow: var(--lt-elevation-3);
  }
</style>

<script>
  import '@latty/web';
</script>
