  border-radius: 12px;
  padding: var(--lt-spacing-12) var(--lt-spacing-10);
  text-align: center;
}
.heroBadge  { display: inline-block; margin-bottom: var(--lt-spacing-4); }
.heroTitle  { color: #fff; margin-bottom: var(--lt-spacing-4); }
.heroSub    { color: rgba(255, 255, 255, 0.85); margin-bottom: var(--lt-spacing-8); }
.heroActions { display: flex; gap: var(--lt-spacing-3); justify-content: center; flex-wrap: wrap; }
.heroOutline::part(base) { border-color: rgba(255, 255, 255, 0.7); color: #fff; }
