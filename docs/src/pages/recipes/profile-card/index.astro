---
import BaseLayout from '../../../layouts/BaseLayout/index.astro';
import RecipePreview from '../../../components/RecipePreview/index.astro';
import FrameworkTabs from '../../../components/FrameworkTabs/index.astro';
---

<BaseLayout title="Profile Card" description="A user profile widget with avatar, name, role, tags, and action buttons.">
  <lt-text variant="h1">Profile Card</lt-text>
  <lt-text variant="body">
    A compact profile widget for team pages, user cards, and sidebars — shows identity at a glance with skills and
    quick-action buttons.
  </lt-text>

  <lt-text variant="h2">Preview</lt-text>
  <RecipePreview>
    <lt-surface appearance="outlined" elevation="0" style="max-width: 280px; width: 100%;">
      <div
        style="padding: var(--lt-spacing-6); display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--lt-spacing-3);"
      >
        <lt-avatar src="https://picsum.photos/seed/profile-card/200/200" size="xl"></lt-avatar>
        <div>
          <lt-text variant="h5" style="color: var(--lt-text-default);">Alex Morgan</lt-text>
          <lt-text variant="body-sm" style="color: var(--lt-text-subtle);">Senior Product Designer</lt-text>
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: var(--lt-spacing-2); justify-content: center;">
          <lt-chip>Figma</lt-chip>
          <lt-chip>Design Tokens</lt-chip>
          <lt-chip>Web Components</lt-chip>
        </div>
        <lt-divider style="width: 100%;"></lt-divider>
        <div style="display: flex; gap: var(--lt-spacing-2);">
          <lt-button variant="primary" size="sm">Follow</lt-button>
          <lt-button variant="neutral" appearance="outlined" size="sm" icon-start="mail">Message</lt-button>
        </div>
      </div>
    </lt-surface>
  </RecipePreview>

  <lt-text variant="h2">Code</lt-text>
  <FrameworkTabs
    html={`<lt-surface appearance="outlined" elevation="0" style="max-width: 280px; width: 100%;">
  <div style="padding: var(--lt-spacing-6); display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--lt-spacing-3);">
    <lt-avatar src="https://picsum.photos/seed/profile-card/200/200" size="xl"></lt-avatar>
    <div>
      <lt-text variant="h5" style="color: var(--lt-text-default);">Alex Morgan</lt-text>
      <lt-text variant="body-sm" style="color: var(--lt-text-subtle);">Senior Product Designer</lt-text>
    </div>
    <div style="display: flex; flex-wrap: wrap; gap: var(--lt-spacing-2); justify-content: center;">
      <lt-chip>Figma</lt-chip>
      <lt-chip>Design Tokens</lt-chip>
      <lt-chip>Web Components</lt-chip>
    </div>
    <lt-divider style="width: 100%;"></lt-divider>
    <div style="display: flex; gap: var(--lt-spacing-2);">
      <lt-button variant="primary" size="sm">Follow</lt-button>
      <lt-button variant="neutral" appearance="outlined" size="sm" icon-start="mail">Message</lt-button>
    </div>
  </div>
</lt-surface>`}
    react={`import { Surface, Avatar, Text, Chip, Divider, Button } from '@latty-ds/react';

export default function ProfileCard() {
  return (
    <Surface appearance="outlined" elevation="0" style={{ maxWidth: 280, width: '100%' }}>
      <div style={{ padding: 'var(--lt-spacing-6)', display: 'flex', flexDirection: 'column', alignItems: 'center', textAlign: 'center', gap: 'var(--lt-spacing-3)' }}>
        <Avatar src="https://picsum.photos/seed/profile-card/200/200" size="xl" />
        <div>
          <Text variant="h5" style={{ color: 'var(--lt-text-default)' }}>Alex Morgan</Text>
          <Text variant="body-sm" style={{ color: 'var(--lt-text-subtle)' }}>Senior Product Designer</Text>
        </div>
        <div style={{ display: 'flex', flexWrap: 'wrap', gap: 'var(--lt-spacing-2)', justifyContent: 'center' }}>
          <Chip>Figma</Chip>
          <Chip>Design Tokens</Chip>
          <Chip>Web Components</Chip>
        </div>
        <Divider style={{ width: '100%' }} />
        <div style={{ display: 'flex', gap: 'var(--lt-spacing-2)' }}>
          <Button variant="primary" size="sm">Follow</Button>
          <Button variant="neutral" appearance="outlined" size="sm" iconStart="mail">Message</Button>
        </div>
      </div>
    </Surface>
  );
}`}
    vue={`<template>
  <lt-surface appearance="outlined" elevation="0" style="max-width: 280px; width: 100%;">
    <div style="padding: var(--lt-spacing-6); display: flex; flex-direction: column; align-items: center; text-align: center; gap: var(--lt-spacing-3);">
      <lt-avatar src="https://picsum.photos/seed/profile-card/200/200" size="xl"></lt-avatar>
      <div>
        <lt-text variant="h5" style="color: var(--lt-text-default);">Alex Morgan</lt-text>
        <lt-text variant="body-sm" style="color: var(--lt-text-subtle);">Senior Product Designer</lt-text>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: var(--lt-spacing-2); justify-content: center;">
        <lt-chip>Figma</lt-chip>
        <lt-chip>Design Tokens</lt-chip>
        <lt-chip>Web Components</lt-chip>
      </div>
      <lt-divider style="width: 100%;"></lt-divider>
      <div style="display: flex; gap: var(--lt-spacing-2);">
        <lt-button variant="primary" size="sm">Follow</lt-button>
        <lt-button variant="neutral" appearance="outlined" size="sm" icon-start="mail">Message</lt-button>
      </div>
    </div>
  </lt-surface>
</template>`}
  />

  <lt-text variant="h2">Components</lt-text>
  <lt-text variant="body">
    <code>lt-surface</code>, <code>lt-avatar</code>, <code>lt-text</code>, <code>lt-chip</code>, <code>lt-divider</code
    >, <code>lt-button</code>
  </lt-text>
</BaseLayout>

<script>
  import '@latty-ds/web';
</script>
