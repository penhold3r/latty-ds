---
import BaseLayout from '../../../layouts/BaseLayout/index.astro';
import CodeSnippet from '../../../components/CodeSnippet/index.astro';
import FrameworkTabs from '../../../components/FrameworkTabs/index.astro';
import { iconGroups, sizes } from '../_icons.data.ts';

const totalIcons = iconGroups.reduce((sum, g) => sum + g.icons.length, 0);
---

<BaseLayout title="Icons" description="Scalable icon component with a built-in curated icon set">
  <lt-text variant="h1">Icons</lt-text>
  <lt-text variant="body">
    The <code>&lt;lt-icon&gt;</code> component renders SVG icons from the Latty icon registry. The built-in set includes <strong
      >{totalIcons} icons</strong
    > across {iconGroups.length} categories — all custom-drawn SVGs that inherit color via <code>currentColor</code>.
    Click any icon below to copy its usage snippet.
  </lt-text>

  <lt-text variant="h2">Design Assets</lt-text>
  <lt-text variant="body">
    Download all {totalIcons} icons as ready-to-use SVG files for Figma, Sketch, or any design tool. Each icon is a 24×24
    SVG with a black stroke — import once, then recolor freely.
  </lt-text>
  <a href="/assets/latty-icons.zip" download="latty-icons.zip">
    <lt-button icon-start="download">Download SVGs (.zip, {totalIcons} icons)</lt-button>
  </a>

  <lt-text variant="h2">Installation</lt-text>
  <lt-text variant="body"
    >Icons are included in <code>@latty-ds/web</code> — no extra package needed for basic usage:</lt-text
  >
  <CodeSnippet code={`import '@latty-ds/web'; // registers <lt-icon> along with all other components`} />
  <lt-text variant="body">If you only need icons (no other components), install the icons package directly:</lt-text>
  <CodeSnippet
    code={`# pnpm
pnpm add @latty-ds/icons

# npm
npm install @latty-ds/icons

# yarn
yarn add @latty-ds/icons`}
  />
  <CodeSnippet
    code={`// All built-in icons are registered automatically when the package is imported.
// For per-icon tree-shaking, import individual icons instead:
import '@latty-ds/icons/star';
import '@latty-ds/icons/arrow-right';`}
  />

  <lt-text variant="h2">Available Icons</lt-text>

  <div class="size-filter">
    <span class="size-filter-label">Size</span>
    {
      sizes.map((s) => (
        <button class="size-btn" data-size={s.name} aria-pressed="false">
          {s.name}
        </button>
      ))
    }
  </div>

  {
    iconGroups.map((group) => (
      <div class="icon-group">
        <lt-text variant="overline">{group.label}</lt-text>
        <div class="icon-grid">
          {group.icons.map((name) => (
            <button
              class="icon-tile"
              data-name={name}
              title={`Copy <lt-icon name="${name}" />`}
              aria-label={`Copy usage for ${name}`}
            >
              <span class="icon-wrapper">
                <lt-icon name={name} size="md" class="icon-preview" />
              </span>
              <span class="icon-name">{name}</span>
            </button>
          ))}
        </div>
      </div>
    ))
  }

  <div class="copy-toast" aria-live="polite" aria-atomic="true"></div>

  <lt-text variant="h2">Sizes</lt-text>
  <div class="sizes-row">
    {
      sizes.map((s) => (
        <div class="size-demo">
          <lt-icon name="star" size={s.name} />
          <span class="size-name">{s.name}</span>
          <span class="size-px">{s.px}</span>
        </div>
      ))
    }
  </div>

  <lt-text variant="h2">Usage</lt-text>
  <FrameworkTabs
    html={`import '@latty-ds/icons/star';

<!-- Default size (md = 20px) -->
<lt-icon name="star" />

<!-- With explicit size -->
<lt-icon name="arrow-right" size="lg" />

<!-- Color is inherited from CSS -->
<lt-icon name="check-circle" style="color: var(--lt-color-success-500)" />`}
    react={`import { Icon } from '@latty-ds/react';

{/* Default size (md = 20px) */}
<Icon name="star" />

{/* With explicit size */}
<Icon name="arrow-right" size="lg" />

{/* Color is inherited via CSS */}
<Icon name="check-circle" style={{ color: 'var(--lt-color-success-500)' }} />`}
  />

  <lt-text variant="h3">Custom icons</lt-text>
  <CodeSnippet
    code={`import { iconRegistry } from '@latty-ds/icons';

// Register a single icon
iconRegistry.registerIcon('my-logo', '<svg viewBox="0 0 24 24">...</svg>');

// Register multiple at once
iconRegistry.registerIcons({
  'brand-x': '<svg>...</svg>',
  'brand-y': '<svg>...</svg>',
});`}
  />

  <lt-text variant="h2">API</lt-text>
  <lt-table id="icon-api-table" hoverable></lt-table>
</BaseLayout>

<script>
  import '../_icons.script.ts';
</script>

<style>
  @import '../icons.styles.css';
</style>
