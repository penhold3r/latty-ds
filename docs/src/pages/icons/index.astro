---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CodeSnippet from '../../components/CodeSnippet.astro';
import FrameworkTabs from '../../components/FrameworkTabs.astro';

const iconGroups = [
  {
    label: 'Navigation',
    icons: [
      'arrow-left',
      'arrow-right',
      'arrow-up',
      'arrow-down',
      'caret-left',
      'caret-right',
      'caret-up',
      'caret-down',
      'external',
      'location',
      'return',
      'compass'
    ]
  },
  {
    label: 'Actions',
    icons: ['check', 'xmark', 'plus', 'minus', 'edit', 'trash', 'save', 'download', 'upload', 'copy', 'share', 'link']
  },
  {
    label: 'UI Elements',
    icons: [
      'search',
      'menu',
      'settings',
      'home',
      'user',
      'bell',
      'calendar',
      'clock',
      'mail',
      'phone',
      'chart',
      'folder'
    ]
  },
  {
    label: 'Feedback',
    icons: [
      'info-circle',
      'warning-triangle',
      'check-circle',
      'xmark-circle',
      'question-circle',
      'shield',
      'flag',
      'bookmark',
      'thumb-up',
      'thumb-down',
      'fire',
      'lock'
    ]
  },
  {
    label: 'Interaction',
    icons: [
      'eye',
      'eye-off',
      'zoom-in',
      'zoom-out',
      'expand',
      'collapse',
      'drag',
      'cursor',
      'switch',
      'rotate-cw',
      'undo',
      'redo'
    ]
  },
  {
    label: 'Shapes',
    icons: [
      'heart',
      'star',
      'diamond',
      'hexagon',
      'double-circle',
      'circle',
      'square',
      'triangle',
      'cloud',
      'lightning',
      'moon',
      'sun'
    ]
  },
  {
    label: 'Social',
    icons: [
      'x',
      'instagram',
      'whatsapp',
      'github',
      'youtube',
      'linkedin',
      'facebook',
      'tiktok',
      'discord',
      'telegram',
      'slack',
      'dribbble'
    ]
  }
];

const totalIcons = iconGroups.reduce((sum, g) => sum + g.icons.length, 0);

const sizes = [
  { name: 'xs', px: '12px' },
  { name: 'sm', px: '16px' },
  { name: 'md', px: '20px' },
  { name: 'lg', px: '24px' },
  { name: 'xl', px: '32px' }
];
---

<BaseLayout title="Icons" description="Scalable icon component with a built-in curated icon set">
  <lt-text variant="h1">Icons</lt-text>
  <lt-text variant="body">
    The <code>&lt;lt-icon&gt;</code> component renders SVG icons from the Latty icon registry. The built-in set includes <strong
      >{totalIcons} icons</strong
    > across {iconGroups.length} categories — all custom-drawn SVGs that inherit color via <code>currentColor</code>.
    Click any icon below to copy its usage snippet.
  </lt-text>

  <lt-text variant="h2">Installation</lt-text>
  <lt-text variant="body"
    >Icons are included in <code>@latty/web</code> — no extra package needed for basic usage:</lt-text
  >
  <CodeSnippet code={`import '@latty/web'; // registers <lt-icon> along with all other components`} />
  <lt-text variant="body">If you only need icons (no other components), install the icons package directly:</lt-text>
  <CodeSnippet
    code={`# pnpm
pnpm add @latty/icons

# npm
npm install @latty/icons

# yarn
yarn add @latty/icons`}
  />
  <CodeSnippet code={`import '@latty/icons'; // registers <lt-icon> with the built-in icon set`} />

  <lt-text variant="h2">Available Icons</lt-text>

  <div class="size-filter">
    <span class="size-filter-label">Size</span>
    {
      sizes.map((s) => (
        <button class="size-btn" data-size={s.name} aria-pressed="false">
          {s.name}
        </button>
      ))
    }
  </div>

  {
    iconGroups.map((group) => (
      <div class="icon-group">
        <lt-text variant="overline">{group.label}</lt-text>
        <div class="icon-grid">
          {group.icons.map((name) => (
            <button
              class="icon-tile"
              data-name={name}
              title={`Copy <lt-icon name="${name}" />`}
              aria-label={`Copy usage for ${name}`}
            >
              <span class="icon-wrapper">
                <lt-icon name={name} size="md" class="icon-preview" />
              </span>
              <span class="icon-name">{name}</span>
            </button>
          ))}
        </div>
      </div>
    ))
  }

  <div class="copy-toast" aria-live="polite" aria-atomic="true"></div>

  <lt-text variant="h2">Sizes</lt-text>
  <div class="sizes-row">
    {
      sizes.map((s) => (
        <div class="size-demo">
          <lt-icon name="star" size={s.name} />
          <span class="size-name">{s.name}</span>
          <span class="size-px">{s.px}</span>
        </div>
      ))
    }
  </div>

  <lt-text variant="h2">Usage</lt-text>
  <FrameworkTabs
    html={`import '@latty/icons';

<!-- Default size (md = 20px) -->
<lt-icon name="star" />

<!-- With explicit size -->
<lt-icon name="arrow-right" size="lg" />

<!-- Color is inherited from CSS -->
<lt-icon name="check-circle" style="color: var(--lt-color-success-500)" />`}
    react={`import { Icon } from '@latty/react';

{/* Default size (md = 20px) */}
<Icon name="star" />

{/* With explicit size */}
<Icon name="arrow-right" size="lg" />

{/* Color is inherited via CSS */}
<Icon name="check-circle" style={{ color: 'var(--lt-color-success-500)' }} />`}
  />

  <lt-text variant="h3">Custom icons</lt-text>
  <CodeSnippet
    code={`import { iconRegistry } from '@latty/icons';

// Register a single icon
iconRegistry.registerIcon('my-logo', '<svg viewBox="0 0 24 24">...</svg>');

// Register multiple at once
iconRegistry.registerIcons({
  'brand-x': '<svg>...</svg>',
  'brand-y': '<svg>...</svg>',
});`}
  />

  <lt-text variant="h2">API</lt-text>
  <lt-table id="icon-api-table" hoverable></lt-table>
</BaseLayout>

<script>
  import '@latty/icons';
  import '@latty/web';

  // ── API table ────────────────────────────────────────────────────────────────
  const iconApiTable = document.getElementById('icon-api-table') as any;
  if (iconApiTable) {
    function codeEl(color: string, nowrap = false) {
      return (v: unknown) => {
        const el = document.createElement('code');
        el.style.color = color;
        el.style.fontFamily = 'monospace';
        el.style.fontSize = '0.875rem';
        if (nowrap) el.style.whiteSpace = 'nowrap';
        el.textContent = String(v ?? '');
        return el;
      };
    }

    iconApiTable.columns = [
      { key: 'name', label: 'Property', render: codeEl('var(--lt-color-primary-700)', true) },
      { key: 'type', label: 'Type', render: codeEl('var(--lt-color-secondary-700)') },
      { key: 'default', label: 'Default', render: codeEl('var(--lt-color-neutral-600)', true) },
      { key: 'description', label: 'Description' }
    ];
    iconApiTable.data = [
      {
        name: 'name',
        type: 'string',
        default: '—',
        description: "Icon identifier (e.g. 'arrow-left', 'check-circle')."
      },
      {
        name: 'size',
        type: "'xs' | 'sm' | 'md' | 'lg' | 'xl'",
        default: "'md'",
        description: 'Rendered size — 12 / 16 / 20 / 24 / 32 px.'
      }
    ];
  }

  // ── Size filter ──────────────────────────────────────────────────────────────
  let activeSize = 'md';

  document.querySelectorAll<HTMLButtonElement>('.size-btn').forEach((btn) => {
    if (btn.dataset.size === activeSize) btn.setAttribute('aria-pressed', 'true');

    btn.addEventListener('click', () => {
      activeSize = btn.dataset.size!;
      document.querySelectorAll<HTMLButtonElement>('.size-btn').forEach((b) => {
        b.setAttribute('aria-pressed', b.dataset.size === activeSize ? 'true' : 'false');
      });
      document.querySelectorAll<any>('.icon-preview').forEach((el) => {
        el.size = activeSize;
      });
    });
  });

  // ── Click-to-copy ────────────────────────────────────────────────────────────
  const toast = document.querySelector<HTMLElement>('.copy-toast')!;
  let toastTimer: ReturnType<typeof setTimeout>;

  document.querySelectorAll<HTMLButtonElement>('.icon-tile').forEach((tile) => {
    tile.addEventListener('click', async () => {
      const name = tile.dataset.name!;
      const snippet = `<lt-icon name="${name}" />`;
      await navigator.clipboard.writeText(snippet);

      clearTimeout(toastTimer);
      toast.textContent = `Copied: ${snippet}`;
      toast.classList.add('is-visible');
      toastTimer = setTimeout(() => toast.classList.remove('is-visible'), 2000);
    });
  });
</script>

<style>
  /* ── Size filter ─────────────────────────────────────────────────────────── */
  .size-filter {
    display: flex;
    align-items: center;
    gap: var(--lt-spacing-2);
    margin-bottom: var(--lt-spacing-6);
    flex-wrap: wrap;
  }

  .size-filter-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--lt-color-neutral-500);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-right: var(--lt-spacing-1);
  }

  .size-btn {
    padding: var(--lt-spacing-1) var(--lt-spacing-3);
    border-radius: 999px;
    border: 1px solid var(--lt-color-neutral-300);
    background: none;
    font-size: 0.8125rem;
    cursor: pointer;
    color: var(--lt-color-neutral-600);
    transition:
      background 120ms,
      border-color 120ms,
      color 120ms;
  }

  .size-btn:hover {
    background: var(--lt-color-neutral-100);
    color: var(--lt-color-neutral-900);
  }

  .size-btn[aria-pressed='true'] {
    background: var(--lt-color-primary-100);
    border-color: var(--lt-color-primary-400);
    color: var(--lt-color-primary-700);
    font-weight: 600;
  }

  /* ── Icon groups ─────────────────────────────────────────────────────────── */
  .icon-group {
    margin-bottom: var(--lt-spacing-6);
  }

  lt-text[variant='overline'] {
    margin: 0 0 var(--lt-spacing-3);
    display: block;
  }

  .icon-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
    gap: var(--lt-spacing-2);
  }

  /* ── Icon tile ───────────────────────────────────────────────────────────── */
  .icon-tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--lt-spacing-2);
    padding: var(--lt-spacing-4) var(--lt-spacing-2);
    background: none;
    border: 1px solid var(--lt-color-neutral-200);
    border-radius: 8px;
    cursor: pointer;
    color: var(--lt-color-neutral-700);
    transition:
      background 120ms,
      border-color 120ms,
      color 120ms,
      transform 80ms;
    min-height: 72px;
  }

  .icon-tile:hover {
    background: var(--lt-color-primary-50);
    border-color: var(--lt-color-primary-200);
    color: var(--lt-color-primary-700);
    transform: translateY(-1px);
  }

  .icon-tile:active {
    transform: translateY(0);
  }

  .icon-name {
    font-size: 0.6875rem;
    text-align: center;
    line-height: 1.3;
    word-break: break-all;
    color: inherit;
  }

  .icon-wrapper {
    color: var(--lt-color-neutral-700);
  }

  /* ── Toast ───────────────────────────────────────────────────────────────── */
  .copy-toast {
    position: fixed;
    bottom: var(--lt-spacing-6);
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    background: var(--lt-color-neutral-900);
    color: var(--lt-color-neutral-50);
    padding: var(--lt-spacing-2) var(--lt-spacing-4);
    border-radius: 6px;
    font-size: 0.8125rem;
    font-family: monospace;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 150ms,
      transform 150ms;
    z-index: 1000;
    white-space: nowrap;
  }

  .copy-toast.is-visible {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* ── Sizes demo ──────────────────────────────────────────────────────────── */
  .sizes-row {
    display: flex;
    align-items: flex-end;
    gap: var(--lt-spacing-8);
    padding: var(--lt-spacing-6);
    background: var(--lt-color-neutral-50);
    border: 1px solid var(--lt-color-neutral-200);
    border-radius: 8px;
    margin-bottom: var(--lt-spacing-6);
    flex-wrap: wrap;
  }

  .size-demo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--lt-spacing-2);
    color: var(--lt-color-neutral-700);
  }

  .size-name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--lt-color-neutral-700);
  }

  .size-px {
    font-size: 0.75rem;
    color: var(--lt-color-neutral-400);
  }

  /* ── API table ───────────────────────────────────────────────────────────── */
  #icon-api-table {
    border: 1px solid var(--lt-color-neutral-200);
    border-radius: 8px;
    font-size: 0.875rem;
    margin: var(--lt-spacing-4) 0;
  }
</style>
