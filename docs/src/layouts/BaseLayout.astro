---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A framework-agnostic design system built on design tokens and Web Components' } =
  Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Latty</title>
  </head>
  <body>
    <lt-header variant="primary" class="topbar">
      <button
        slot="before"
        class="menu-toggle"
        id="menu-toggle"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="sidebar"
      >
        <lt-icon name="menu" size="md" aria-hidden="true"></lt-icon>
      </button>
      <a slot="logo" href={`${base}/`} class="wordmark">
        <span class="wordmark-accent">Latty</span>
      </a>
      <a
        slot="after"
        href="https://github.com/yourusername/latty-ds"
        target="_blank"
        rel="noopener noreferrer"
        class="github-link"
        aria-label="GitHub"
      >
        <lt-icon name="github" size="md" aria-hidden="true"></lt-icon>
      </a>
    </lt-header>

    <div id="overlay" class="overlay" aria-hidden="true"></div>

    <div class="page-layout">
      <Sidebar />
      <main class="content">
        <article class="prose">
          <slot />
        </article>
      </main>
    </div>
  </body>
</html>

<style>
  :root {
    --topbar-height: 64px;
    --sidebar-width: 240px;
  }

  .topbar {
    z-index: 200;
  }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--lt-color-neutral-100);
    padding: var(--lt-spacing-1);
    border-radius: 4px;
  }

  .menu-toggle:hover {
    background: color-mix(in srgb, white 15%, transparent);
  }

  .wordmark {
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
  }

  .wordmark-accent {
    color: var(--lt-color-primary-50);
  }

  .github-link {
    color: var(--lt-color-neutral-50);
    display: flex;
    align-items: center;
    text-decoration: none;
    padding: var(--lt-spacing-1);
    border-radius: 4px;
  }

  .github-link:hover {
    color: var(--lt-color-neutral-200);
  }

  .overlay {
    display: none;
    position: fixed;
    inset: 0;
    top: var(--topbar-height);
    background: rgba(0, 0, 0, 0.4);
    z-index: 99;
  }

  .overlay.is-open {
    display: block;
  }

  .page-layout {
    display: flex;
    min-height: calc(100vh - var(--topbar-height));
  }

  .content {
    flex: 1;
    min-width: 0;
    padding: var(--lt-spacing-8) var(--lt-spacing-10);
  }

  .prose {
    max-width: 768px;
  }

  @media (max-width: 768px) {
    .menu-toggle {
      display: flex;
      align-items: center;
    }

    .content {
      padding: var(--lt-spacing-6) var(--lt-spacing-4);
    }
  }
</style>

<script>
  import '@latty/web';
  import '@latty/icons';

  const toggle = document.getElementById('menu-toggle');
  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('overlay');

  function openSidebar() {
    sidebar?.classList.add('is-open');
    overlay?.classList.add('is-open');
    toggle?.setAttribute('aria-expanded', 'true');
  }

  function closeSidebar() {
    sidebar?.classList.remove('is-open');
    overlay?.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');
  }

  toggle?.addEventListener('click', () => {
    const isOpen = sidebar?.classList.contains('is-open');
    if (isOpen) {
      closeSidebar();
    } else {
      openSidebar();
    }
  });

  overlay?.addEventListener('click', closeSidebar);

  // Close sidebar on nav link click (mobile) — lt-nav-item-click is composed and bubbles out of shadow DOM
  sidebar?.addEventListener('lt-nav-item-click', (e) => {
    const { href } = (e as CustomEvent).detail;
    if (href) closeSidebar();
  });
</script>
