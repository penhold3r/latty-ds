---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import lernaJson from '../../../lerna.json';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A framework-agnostic design system built on design tokens and Web Components' } =
  Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const version = `v${lernaJson.version}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Latty</title>
  </head>
  <body>
    <lt-header background="primary" class="topbar">
      <button
        slot="before"
        class="menu-toggle"
        id="menu-toggle"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="nav-panel"
      >
        <lt-icon name="menu" size="md" aria-hidden="true"></lt-icon>
      </button>
      <a slot="logo" href={`${base}/`} class="wordmark">
        <span class="wordmark-accent">Latty</span>
        <span class="version-badge">{version}</span>
      </a>
      <a
        slot="after"
        href="https://github.com/yourusername/latty-ds"
        target="_blank"
        rel="noopener noreferrer"
        class="github-link"
        aria-label="GitHub"
      >
        <lt-icon name="github" size="md" aria-hidden="true"></lt-icon>
      </a>
    </lt-header>

    <lt-sidepanel id="nav-panel" anchor="left" size="240px" no-close-button>
      <Sidebar inPanel={true} />
    </lt-sidepanel>

    <div class="page-layout">
      <Sidebar />
      <main class="content">
        <article class="prose">
          <slot />
        </article>
      </main>
    </div>

    <footer class="footer">
      <p class="footer-copy">© {year} Latty Design System. All rights reserved.</p>
    </footer>
  </body>
</html>

<style>
  :root {
    --topbar-height: 64px;
    --sidebar-width: 240px;
    --page-max-width: 1400px;
  }

  .topbar {
    z-index: 200;
  }

  .topbar::part(inner) {
    max-width: var(--page-max-width);
    margin: 0 auto;
  }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--lt-color-neutral-100);
    padding: var(--lt-spacing-1);
    border-radius: 4px;
  }

  .menu-toggle:hover {
    background: color-mix(in srgb, white 15%, transparent);
  }

  .wordmark {
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .wordmark-accent {
    color: var(--lt-color-primary-50);
  }

  .version-badge {
    font-size: 0.7rem;
    font-weight: 600;
    color: #fff;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.35);
    padding: 2px 8px;
    border-radius: 999px;
    letter-spacing: 0.03em;
    align-self: center;
    line-height: 1.6;
  }

  .github-link {
    color: var(--lt-color-neutral-50);
    display: flex;
    align-items: center;
    text-decoration: none;
    padding: var(--lt-spacing-1);
    border-radius: 4px;
  }

  .github-link:hover {
    color: var(--lt-color-neutral-200);
  }

  /* Anchor the nav panel below the topbar */
  #nav-panel::part(panel),
  #nav-panel::part(overlay) {
    top: var(--topbar-height);
  }

  :global(body) {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .page-layout {
    display: flex;
    flex: 1;
    max-width: var(--page-max-width);
    margin: 0 auto;
    width: 100%;
  }

  .footer {
    background: var(--lt-color-primary-100);
    border-top: 1px solid var(--lt-color-primary-200);
    padding: var(--lt-spacing-8) var(--lt-spacing-10);
    text-align: center;
  }

  .footer-copy {
    margin: 0;
    font-size: 0.875rem;
    color: var(--lt-color-primary-800);
  }

  .content {
    flex: 1;
    min-width: 0;
    padding: var(--lt-spacing-8) var(--lt-spacing-10);
  }

  .prose {
    max-width: 768px;
  }

  @media (max-width: 768px) {
    .menu-toggle {
      display: flex;
      align-items: center;
    }

    .content {
      padding: var(--lt-spacing-6) var(--lt-spacing-4);
    }

    /* Hide the static sidebar — lt-sidepanel handles mobile nav */
    .page-layout > :global(.sidebar) {
      display: none;
    }
  }
</style>

<script>
  import '@latty/web';
  import '@latty/icons';

  import type { SidePanel } from '@latty/web';

  const toggle = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const navPanel = document.getElementById('nav-panel') as (HTMLElement & SidePanel) | null;

  toggle?.addEventListener('click', () => {
    navPanel?.toggle();
    toggle.setAttribute('aria-expanded', String(navPanel?.open ?? false));
  });

  // Sync aria-expanded when panel closes via backdrop, Escape, or other means
  navPanel?.addEventListener('lt-close', () => {
    toggle?.setAttribute('aria-expanded', 'false');
  });

  navPanel?.addEventListener('lt-nav-item-click', (e: Event) => {
    const { href } = (e as CustomEvent).detail;
    if (href) navPanel.hide();
  });
</script>
