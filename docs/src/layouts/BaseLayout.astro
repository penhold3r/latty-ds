---
import { Image } from 'astro:assets';
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import lernaJson from '../../../lerna.json';
import lattyLogo from '../assets/latty-logo.png';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A framework-agnostic design system built on design tokens and Web Components' } =
  Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const version = `v${lernaJson.version}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Latty</title>
    <!-- Inline: read saved theme before first paint to avoid flash -->
    <script is:inline>
      const saved = localStorage.getItem('lt-theme');
      if (saved) document.documentElement.setAttribute('data-theme', saved);
    </script>
  </head>
  <body>
    <lt-header background="primary" class="topbar">
      <button
        slot="before"
        class="menu-toggle"
        id="menu-toggle"
        aria-label="Toggle navigation"
        aria-expanded="false"
        aria-controls="nav-panel"
      >
        <lt-icon name="menu" size="md" aria-hidden="true"></lt-icon>
      </button>
      <a slot="logo" href={`${base}/`} class="wordmark">
        <Image src={lattyLogo} alt="Latty" height={28} class="wordmark-logo" />
      </a>
      <div slot="after" class="header-end">
        <span class="version-badge">{version}</span>
        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
          <!-- Moon: shown in light mode — click to go dark -->
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" width="18" height="18" aria-hidden="true">
            <path
              d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <!-- Sun: shown in dark mode — click to go light -->
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" width="18" height="18" aria-hidden="true">
            <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"></circle>
            <path
              d="M12 2v2M12 20v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M2 12h2M20 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
        </button>
        <a
          href="https://github.com/yourusername/latty-ds"
          target="_blank"
          rel="noopener noreferrer"
          class="github-link"
          aria-label="GitHub"
        >
          <lt-icon name="github" size="md" aria-hidden="true"></lt-icon>
        </a>
      </div>
    </lt-header>

    <lt-sidepanel id="nav-panel" anchor="left" size="240px" no-close-button>
      <Sidebar inPanel={true} />
    </lt-sidepanel>

    <div class="page-layout">
      <Sidebar />
      <main class="content">
        <article class="prose">
          <slot />
        </article>
      </main>
    </div>

    <footer class="footer">
      <p class="footer-copy">© {year} Latty Design System. All rights reserved.</p>
    </footer>
  </body>
</html>

<style>
  :root {
    --topbar-height: 64px;
    --sidebar-width: 240px;
    --page-max-width: 1400px;
  }

  .topbar {
    z-index: 200;
  }

  .topbar::part(inner) {
    max-width: var(--page-max-width);
    margin: 0 auto;
  }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--lt-color-neutral-100);
    padding: var(--lt-spacing-1);
    border-radius: 4px;
  }

  .menu-toggle:hover {
    background: color-mix(in srgb, white 15%, transparent);
  }

  .wordmark {
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .wordmark-logo {
    height: 28px;
    width: auto;
    display: block;
  }

  .version-badge {
    font-size: 0.7rem;
    font-weight: 600;
    color: #fff;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.35);
    padding: 2px 8px;
    border-radius: 999px;
    letter-spacing: 0.03em;
    align-self: center;
    line-height: 1.6;
  }

  .header-end {
    display: flex;
    align-items: center;
    gap: var(--lt-spacing-3);
  }

  .theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--lt-color-neutral-100);
    padding: var(--lt-spacing-1);
    border-radius: 4px;
    display: flex;
    align-items: center;
  }

  .theme-toggle:hover {
    background: color-mix(in srgb, white 15%, transparent);
  }

  /* show moon in light, sun in dark */
  .icon-sun {
    display: none;
  }

  :global([data-theme='dark']) .icon-sun {
    display: block;
  }
  :global([data-theme='dark']) .icon-moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-sun {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .icon-moon {
      display: none;
    }
  }

  .github-link {
    color: var(--lt-color-neutral-50);
    display: flex;
    align-items: center;
    text-decoration: none;
    padding: var(--lt-spacing-1);
    border-radius: 4px;
  }

  .github-link:hover {
    color: var(--lt-color-neutral-200);
  }

  /* Anchor the nav panel below the topbar */
  #nav-panel::part(panel),
  #nav-panel::part(overlay) {
    top: var(--topbar-height);
  }

  :global(body) {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .page-layout {
    display: flex;
    flex: 1;
    max-width: var(--page-max-width);
    margin: 0 auto;
    width: 100%;
  }

  .footer {
    background: var(--lt-bg-primary-subtle);
    border-top: 1px solid var(--lt-border-primary);
    padding: var(--lt-spacing-8) var(--lt-spacing-10);
    text-align: center;
  }

  .footer-copy {
    margin: 0;
    font-size: 0.875rem;
    color: var(--lt-text-primary);
  }

  .content {
    flex: 1;
    min-width: 0;
    padding: var(--lt-spacing-8) var(--lt-spacing-10);
  }

  .prose {
    max-width: 768px;
  }

  @media (max-width: 768px) {
    .menu-toggle {
      display: flex;
      align-items: center;
    }

    .content {
      padding: var(--lt-spacing-6) var(--lt-spacing-4);
    }

    /* Hide the static sidebar — lt-sidepanel handles mobile nav */
    .page-layout > :global(.sidebar) {
      display: none;
    }
  }
</style>

<script>
  import '@latty/web';
  import '@latty/icons';

  import type { SidePanel } from '@latty/web';

  // ── Theme toggle ──────────────────────────────────────────────────────────
  const themeBtn = document.getElementById('theme-toggle') as HTMLButtonElement | null;

  themeBtn?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme');
    const osPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const effective = current ?? (osPrefersDark ? 'dark' : 'light');
    const next = effective === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('lt-theme', next);
  });

  // ── Mobile nav ────────────────────────────────────────────────────────────
  const toggle = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const navPanel = document.getElementById('nav-panel') as (HTMLElement & SidePanel) | null;

  toggle?.addEventListener('click', () => {
    navPanel?.toggle();
    toggle.setAttribute('aria-expanded', String(navPanel?.open ?? false));
  });

  // Sync aria-expanded when panel closes via backdrop, Escape, or other means
  navPanel?.addEventListener('lt-close', () => {
    toggle?.setAttribute('aria-expanded', 'false');
  });

  navPanel?.addEventListener('lt-nav-item-click', (e: Event) => {
    const { href } = (e as CustomEvent).detail;
    if (href) navPanel.hide();
  });
</script>
