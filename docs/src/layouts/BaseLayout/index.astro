---
import { Image, getImage } from 'astro:assets';
import '../../styles/global.css';
import Sidebar from '../../components/Sidebar/index.astro';
import lernaJson from '../../../../lerna.json';
import lattyLogo from '../../assets/latty-logo-white.png';
import lattyFaviconIco from '../../assets/latty-favicon.ico?url';
import lattyFaviconSvg from '../../assets/latty-favicon.svg';
import lattyFaviconPng from '../../assets/latty-favicon.png';
import lattyOg from '../../assets/latty-og.png';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A framework-agnostic design system built on design tokens and Web Components' } =
  Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const version = `v${lernaJson.version}`;
const year = new Date().getFullYear();

const ogImage = await getImage({ src: lattyOg, format: 'png' });
const siteOrigin = Astro.site?.toString().replace(/\/$/, '') ?? '';
const ogImageUrl = `${siteOrigin}${ogImage.src}`;
const canonicalUrl = `${siteOrigin}${Astro.url.pathname}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href={lattyFaviconIco} />
    <link rel="icon" type="image/svg+xml" href={lattyFaviconSvg.src} />
    <link rel="icon" type="image/png" href={lattyFaviconPng.src} />
    <link rel="apple-touch-icon" href={lattyFaviconPng.src} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Latty</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Latty Design System" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | Latty`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Latty`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <!-- Inline: read saved theme before first paint to avoid flash -->
    <script is:inline>
      const urlTheme = new URLSearchParams(location.search).get('theme');
      const saved = urlTheme || localStorage.getItem('lt-theme');
      if (saved) document.documentElement.setAttribute('data-theme', saved);
    </script>
  </head>
  <body>
    <lt-header background="primary" class="topbar">
      <lt-icon-button
        slot="before"
        class="header-btn menu-toggle"
        id="menu-toggle"
        label="Toggle navigation"
        icon="menu"
        size="sm"
        round
        aria-expanded="false"
        aria-controls="nav-panel"></lt-icon-button>
      <a slot="logo" href={`${base}/`} class="wordmark">
        <Image src={lattyLogo} alt="Latty" height={28} class="wordmark-logo" />
      </a>
      <div slot="after" class="header-end">
        <span class="version-badge">{version}</span>
        <lt-icon-button class="header-btn" id="theme-toggle" label="Toggle theme" icon="moon" size="sm" round
        ></lt-icon-button>
        <lt-icon-button
          class="header-btn"
          label="View on GitHub"
          icon="github"
          size="sm"
          href="https://github.com/penhold3r/latty-ds"
          target="_blank"
          rel="noopener noreferrer"
          round></lt-icon-button>
      </div>
    </lt-header>

    <lt-sidepanel id="nav-panel" anchor="left" size="240px" no-close-button>
      <Sidebar inPanel={true} />
    </lt-sidepanel>

    <div class="page-layout">
      <Sidebar />
      <main class="content">
        <article class="prose">
          <slot />
        </article>
      </main>
    </div>

    <footer class="footer">
      <p class="footer-copy">© {year} Latty Design System. All rights reserved.</p>
    </footer>
  </body>
</html>

<style>
  @import './BaseLayout.styles.css';
</style>

<script>
  import './BaseLayout.script.ts';
</script>
