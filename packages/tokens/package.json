{
  "name": "@latty/tokens",
  "version": "0.1.0",
  "description": "Design tokens for the Latty design system — generates CSS custom properties, JSON, and JavaScript exports from a single config file",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/penhold3r/latty-ds.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://penhold3r.github.io/latty-ds",
  "keywords": [
    "design-system",
    "design-tokens",
    "css-variables",
    "css-custom-properties",
    "tokens",
    "latty"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/public-types.d.ts",
  "exports": {
    ".": {
      "types": "./dist/public-types.d.ts",
      "default": "./dist/index.js"
    },
    "./configure": {
      "types": "./dist/configure.d.ts",
      "default": "./dist/configure.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./semantic.css": "./dist/semantic.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "scripts": {
    "build": "pnpm run build:scripts && pnpm run build:tokens && pnpm run build:types",
    "build:scripts": "tsup",
    "build:tokens": "node ./dist-scripts/tokens.js",
    "build:types": "tsc -p tsconfig.types.json",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist dist-scripts"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@latty/utils": "workspace:*",
    "culori": "^4.0.2"
  }
}
