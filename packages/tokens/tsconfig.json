{
  "extends": "../../tsconfig.base.json",
  "include": ["src"],
  "compilerOptions": {
    "jsx": "react-jsx",
    // tsup's declaration build injects its own baseUrl, which TypeScript 6
    // reports as deprecated (TS5101) — "6.0" silences it (see utils/tsconfig).
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true,
    "types": ["node"]
  }
}
