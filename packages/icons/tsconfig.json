{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    // Overrides the base config's Bundler resolution (X7): this package is loaded directly by Node's native ESM
    // resolver (no bundler in between, unlike web/react/docs), which requires explicit file extensions on every
    // relative specifier. nodenext requires writing the *emitted* .js extension in source even though the file
    // on disk is .ts — the relative imports across this package's source (and the generated src/entries/*.ts,
    // see scripts/build-entries.mjs) are written with that in mind.
    "module": "nodenext",
    "moduleResolution": "nodenext"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.stories.ts"]
}
