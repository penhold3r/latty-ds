{
  "name": "@latty-ds/react",
  "version": "0.10.0",
  "description": "React wrappers for the Latty design system — typed React components backed by @latty-ds/web",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/penhold3r/latty-ds.git",
    "directory": "packages/react"
  },
  "homepage": "https://latty-ds.com",
  "keywords": [
    "design-system",
    "react",
    "web-components",
    "ui",
    "latty"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "lit": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@latty-ds/icons": "workspace:*",
    "@latty-ds/web": "workspace:*"
  }
}
