{
  "name": "@latty/web",
  "version": "0.1.0",
  "description": "Web Components for the Latty design system — framework-agnostic UI components built with Lit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/penhold3r/latty-ds.git",
    "directory": "packages/web"
  },
  "homepage": "https://penhold3r.github.io/latty-ds",
  "keywords": [
    "design-system",
    "web-components",
    "custom-elements",
    "lit",
    "ui",
    "latty"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "custom-elements.json"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/components/*/index.js"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css/latty.css": "./dist/css/latty.css",
    "./css/font-face.css": "./dist/css/font-face.css",
    "./manifest.json": "./dist/manifest.json",
    "./accordion": {
      "default": "./dist/components/accordion/index.js"
    },
    "./alert": {
      "default": "./dist/components/alert/index.js"
    },
    "./avatar": {
      "default": "./dist/components/avatar/index.js"
    },
    "./badge": {
      "default": "./dist/components/badge/index.js"
    },
    "./breadcrumb": {
      "default": "./dist/components/breadcrumb/index.js"
    },
    "./button": {
      "default": "./dist/components/button/index.js"
    },
    "./calendar": {
      "default": "./dist/components/calendar/index.js"
    },
    "./checkbox": {
      "default": "./dist/components/checkbox/index.js"
    },
    "./chip": {
      "default": "./dist/components/chip/index.js"
    },
    "./combobox": {
      "default": "./dist/components/combobox/index.js"
    },
    "./date-input": {
      "default": "./dist/components/date-input/index.js"
    },
    "./datepicker": {
      "default": "./dist/components/datepicker/index.js"
    },
    "./dialog": {
      "default": "./dist/components/dialog/index.js"
    },
    "./divider": {
      "default": "./dist/components/divider/index.js"
    },
    "./dropdown": {
      "default": "./dist/components/dropdown/index.js"
    },
    "./header": {
      "default": "./dist/components/header/index.js"
    },
    "./icon-button": {
      "default": "./dist/components/icon-button/index.js"
    },
    "./image": {
      "default": "./dist/components/image/index.js"
    },
    "./link": {
      "default": "./dist/components/link/index.js"
    },
    "./list": {
      "default": "./dist/components/list/index.js"
    },
    "./nav": {
      "default": "./dist/components/nav/index.js"
    },
    "./pagination": {
      "default": "./dist/components/pagination/index.js"
    },
    "./progress": {
      "default": "./dist/components/progress/index.js"
    },
    "./radio": {
      "default": "./dist/components/radio/index.js"
    },
    "./radio-group": {
      "default": "./dist/components/radio-group/index.js"
    },
    "./select": {
      "default": "./dist/components/select/index.js"
    },
    "./shared": {
      "default": "./dist/components/shared/index.js"
    },
    "./sidepanel": {
      "default": "./dist/components/sidepanel/index.js"
    },
    "./skeleton": {
      "default": "./dist/components/skeleton/index.js"
    },
    "./slider": {
      "default": "./dist/components/slider/index.js"
    },
    "./snackbar": {
      "default": "./dist/components/snackbar/index.js"
    },
    "./spinner": {
      "default": "./dist/components/spinner/index.js"
    },
    "./surface": {
      "default": "./dist/components/surface/index.js"
    },
    "./switch": {
      "default": "./dist/components/switch/index.js"
    },
    "./tab": {
      "default": "./dist/components/tab/index.js"
    },
    "./tab-group": {
      "default": "./dist/components/tab-group/index.js"
    },
    "./table": {
      "default": "./dist/components/table/index.js"
    },
    "./text": {
      "default": "./dist/components/text/index.js"
    },
    "./textfield": {
      "default": "./dist/components/textfield/index.js"
    },
    "./tooltip": {
      "default": "./dist/components/tooltip/index.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:ts": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:assets": "mkdir -p dist/css dist/fonts && cp -R src/css/* dist/css/ && cp -R src/font/* dist/fonts/",
    "build:manifest": "cem analyze --config cem.config.mjs && node scripts/build-manifest.mjs",
    "build": "pnpm run clean && pnpm run build:ts && pnpm run build:assets && pnpm run build:manifest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@latty/icons": "workspace:*",
    "lit": "^3.2.0"
  },
  "customElements": "custom-elements.json"
}
